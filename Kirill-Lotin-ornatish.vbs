    s = s & "    MsgBox ""Xatolik "" & CStr(errNum) & "": "" & errDesc, vbExclamation, ""Imlo tekshirish""" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "'------------------------- Takliflar: bosib almashtirish ------------------" & vbCrLf
    s = s & "' Imlo va H/X tekshiruvi shubhali so'zlarni yashirin xatcho'p (_klN) bilan belgilaydi." & vbCrLf
    s = s & "' Takliflar hujjat o'zgaruvchisida (klN) saqlanadi: ""tur|qoida|taklif1 / taklif2""." & vbCrLf
    s = s & "' ImKeyingi / ImJoriy takliflar menyusini ochadi; tanlangan taklif so'zni o'zi almashtiradi." & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function ImMarkNum(ByVal nm As String) As Long" & vbCrLf
    s = s & "    Dim s As String" & vbCrLf
    s = s & "    ImMarkNum = 0" & vbCrLf
    s = s & "    If LCase$(Left$(nm, 3)) <> ""_kl"" Then Exit Function" & vbCrLf
    s = s & "    s = Mid$(nm, 4)" & vbCrLf
    s = s & "    If Len(s) = 0 Or Len(s) > 7 Then Exit Function" & vbCrLf
    s = s & "    If s Like ""*[!0-9]*"" Then Exit Function" & vbCrLf
    s = s & "    ImMarkNum = CLng(s)" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub ImMarkInit()" & vbCrLf
    s = s & "    Dim b As Bookmark, n As Long" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "    gMarkN = 0" & vbCrLf
    s = s & "    For Each b In ActiveDocument.Bookmarks" & vbCrLf
    s = s & "        n = ImMarkNum(b.Name)" & vbCrLf
    s = s & "        If n > gMarkN Then gMarkN = n" & vbCrLf
    s = s & "    Next b" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub ImClearMarks(ByVal scope As Range)" & vbCrLf
    s = s & "    Dim b As Bookmark, col As Collection, v As Variant, r As Range, ci As Long, nm As String" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "    Set col = New Collection" & vbCrLf
    s = s & "    For Each b In ActiveDocument.Bookmarks" & vbCrLf
    s = s & "        If ImMarkNum(b.Name) > 0 Then" & vbCrLf
    s = s & "            If b.Start >= scope.Start And b.End <= scope.End Then col.Add b.Name" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next b" & vbCrLf
    s = s & "    For Each v In col" & vbCrLf
    s = s & "        nm = CStr(v)" & vbCrLf
    s = s & "        Set r = ActiveDocument.Bookmarks(nm).Range" & vbCrLf
    s = s & "        ci = r.HighlightColorIndex" & vbCrLf
    s = s & "        If ci = 5 Or ci = 7 Then r.HighlightColorIndex = 0" & vbCrLf
    s = s & "        ActiveDocument.Bookmarks(nm).Delete" & vbCrLf
    s = s & "        ActiveDocument.Variables(""kl"" & Mid$(nm, 4)).Delete" & vbCrLf
    s = s & "    Next v" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub ImMark(ByVal r As Range, ByVal kind As String, ByVal rule As String, ByVal sug As String)" & vbCrLf
    s = s & "    Dim n As Long, v As String" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    If r.StoryType <> 1 Then" & vbCrLf
    s = s & "        ActiveDocument.Comments.Add r, ""Imlo ("" & rule & ""): "" & sug" & vbCrLf
    s = s & "        Err.Clear" & vbCrLf
    s = s & "        Exit Sub" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    gMarkN = gMarkN + 1" & vbCrLf
    s = s & "    n = gMarkN" & vbCrLf
    s = s & "    v = kind & ""|"" & rule & ""|"" & sug" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.Add ""_kl"" & n, r" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "    ActiveDocument.Variables.Add ""kl"" & n, v" & vbCrLf
    s = s & "    If Err.Number <> 0 Then" & vbCrLf
    s = s & "        Err.Clear" & vbCrLf
    s = s & "        ActiveDocument.Variables(""kl"" & n).Value = v" & vbCrLf
    s = s & "    End If" & vbCrLf
    ModPart20 = s
End Function

Function ModPart21()
    Dim s
    s = ""
    s = s & "    Err.Clear" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function ImMarkInfo(ByVal bm As String, ByRef kind As String, ByRef rule As String, ByRef sug As String) As Boolean" & vbCrLf
    s = s & "    Dim v As String, p() As String" & vbCrLf
    s = s & "    ImMarkInfo = False" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    v = ActiveDocument.Variables(""kl"" & Mid$(bm, 4)).Value" & vbCrLf
    s = s & "    If Err.Number <> 0 Then" & vbCrLf
    s = s & "        Err.Clear" & vbCrLf
    s = s & "        Exit Function" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    If Len(v) = 0 Then Exit Function" & vbCrLf
    s = s & "    p = Split(v, ""|"")" & vbCrLf
    s = s & "    If UBound(p) < 2 Then Exit Function" & vbCrLf
    s = s & "    kind = p(0)" & vbCrLf
    s = s & "    rule = p(1)" & vbCrLf
    s = s & "    sug = p(2)" & vbCrLf
    s = s & "    ImMarkInfo = True" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function ImRuleName(ByVal rule As String) As String" & vbCrLf
    s = s & "    Select Case rule" & vbCrLf
    s = s & "        Case ""h/x"": ImRuleName = ""h va x harflari""" & vbCrLf
    s = s & "        Case ""lug'at"": ImRuleName = ""lug'at bo'yicha""" & vbCrLf
    s = s & "        Case ""alifbo"": ImRuleName = ""harf / belgi xatosi""" & vbCrLf
    s = s & "        Case ""sozl"": ImRuleName = ""og'zaki shakl""" & vbCrLf
    s = s & "        Case ""73"": ImRuleName = ""gap boshi bosh harf""" & vbCrLf
    s = s & "        Case ""51"": ImRuleName = ""chiziqcha bilan yoziladi""" & vbCrLf
    s = s & "        Case ""60"": ImRuleName = ""ajratib yoziladi""" & vbCrLf
    s = s & "        Case ""38-48"": ImRuleName = ""qo'shib yoziladi""" & vbCrLf
    s = s & "        Case ""56"": ImRuleName = ""son + qo'shimcha""" & vbCrLf
    s = s & "        Case ""oy/kun"": ImRuleName = ""oy va kun nomlari""" & vbCrLf
    s = s & "        Case ""67"": ImRuleName = ""joy nomi""" & vbCrLf
    s = s & "        Case ""70/71"": ImRuleName = ""bosh harf bilan yoziladigan ibora""" & vbCrLf
    s = s & "        Case Else: ImRuleName = rule & ""-qoida""" & vbCrLf
    s = s & "    End Select" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function ImCountSame(ByVal txt As String) As Long" & vbCrLf
    s = s & "    Dim b As Bookmark, n As Long" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "    If ActiveDocument.Bookmarks.Count > 1500 Then" & vbCrLf
    s = s & "        ImCountSame = 2" & vbCrLf
    s = s & "        Exit Function" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    For Each b In ActiveDocument.Bookmarks" & vbCrLf
    s = s & "        If ImMarkNum(b.Name) > 0 Then" & vbCrLf
    s = s & "            If b.Range.Text = txt Then n = n + 1" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next b" & vbCrLf
    s = s & "    ImCountSame = n" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub ImShowPopup(ByVal bm As String)" & vbCrLf
    s = s & "    Dim cb As Object, ctl As Object, kind As String, rule As String, sug As String" & vbCrLf
    s = s & "    Dim a() As String, i As Long, n As Long, r As Range, x As Long, y As Long, w As Long, h As Long" & vbCrLf
    s = s & "    Dim txt As String, shown As String, ro As Object" & vbCrLf
    s = s & "    If Not ImMarkInfo(bm, kind, rule, sug) Then Exit Sub" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "    Set r = ActiveDocument.Bookmarks(bm).Range" & vbCrLf
    s = s & "    If r Is Nothing Then Exit Sub" & vbCrLf
    s = s & "    r.Select" & vbCrLf
    s = s & "    gCurBm = bm" & vbCrLf
    s = s & "    txt = r.Text" & vbCrLf
    s = s & "    shown = Replace(Left$(txt, 60), ""&"", ""&&"")" & vbCrLf
    s = s & "    CommandBars(""KLTaklif"").Delete" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "    ' 5 = msoBarPopup" & vbCrLf
    s = s & "    Set cb = CommandBars.Add(""KLTaklif"", 5, False, True)" & vbCrLf
    s = s & "    If cb Is Nothing Then Exit Sub" & vbCrLf
    s = s & "    a = Split(sug, "" / "")" & vbCrLf
    s = s & "    n = UBound(a) + 1" & vbCrLf
    s = s & "    If n > 8 Then n = 8" & vbCrLf
    s = s & "    Set ctl = cb.Controls.Add(1)" & vbCrLf
    s = s & "    If kind = ""fix"" Then" & vbCrLf
    s = s & "        ctl.Caption = ""Xato: "" & shown & ""  ("" & ImRuleName(rule) & "")""" & vbCrLf
    s = s & "    Else" & vbCrLf
    ModPart21 = s
End Function

