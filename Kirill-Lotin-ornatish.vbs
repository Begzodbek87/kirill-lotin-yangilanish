    s = s & "' Takliflar hujjat o'zgaruvchisida (klN) saqlanadi: ""tur|qoida|taklif1 / taklif2""." & vbCrLf
    s = s & "' ImKeyingi / ImJoriy takliflar menyusini ochadi; tanlangan taklif so'zni o'zi almashtiradi." & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function ImMarkNum(ByVal nm As String) As Long" & vbCrLf
    s = s & "    Dim s As String" & vbCrLf
    s = s & "    ImMarkNum = 0" & vbCrLf
    s = s & "    If LCase$(Left$(nm, 3)) <> ""_kl"" Then Exit Function" & vbCrLf
    s = s & "    s = Mid$(nm, 4)" & vbCrLf
    s = s & "    If Len(s) = 0 Or Len(s) > 7 Then Exit Function" & vbCrLf
    s = s & "    If s Like ""*[!0-9]*"" Then Exit Function" & vbCrLf
    s = s & "    ImMarkNum = CLng(s)" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub ImMarkInit()" & vbCrLf
    s = s & "    Dim b As Bookmark, n As Long" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "    gMarkN = 0" & vbCrLf
    s = s & "    For Each b In ActiveDocument.Bookmarks" & vbCrLf
    s = s & "        n = ImMarkNum(b.Name)" & vbCrLf
    s = s & "        If n > gMarkN Then gMarkN = n" & vbCrLf
    s = s & "    Next b" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub ImClearMarks(ByVal scope As Range)" & vbCrLf
    s = s & "    Dim b As Bookmark, col As Collection, v As Variant, r As Range, ci As Long, nm As String" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "    Set col = New Collection" & vbCrLf
    s = s & "    For Each b In ActiveDocument.Bookmarks" & vbCrLf
    s = s & "        If ImMarkNum(b.Name) > 0 Then" & vbCrLf
    s = s & "            If b.Start >= scope.Start And b.End <= scope.End Then col.Add b.Name" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next b" & vbCrLf
    s = s & "    For Each v In col" & vbCrLf
    s = s & "        nm = CStr(v)" & vbCrLf
    s = s & "        Set r = ActiveDocument.Bookmarks(nm).Range" & vbCrLf
    s = s & "        ci = r.HighlightColorIndex" & vbCrLf
    s = s & "        If ci = 5 Or ci = 7 Then r.HighlightColorIndex = 0" & vbCrLf
    s = s & "        ActiveDocument.Bookmarks(nm).Delete" & vbCrLf
    s = s & "        ActiveDocument.Variables(""kl"" & Mid$(nm, 4)).Delete" & vbCrLf
    s = s & "    Next v" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub ImMark(ByVal r As Range, ByVal kind As String, ByVal rule As String, ByVal sug As String)" & vbCrLf
    s = s & "    Dim n As Long, v As String" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    If r.StoryType <> 1 Then" & vbCrLf
    s = s & "        ActiveDocument.Comments.Add r, ""Imlo ("" & rule & ""): "" & sug" & vbCrLf
    s = s & "        Err.Clear" & vbCrLf
    s = s & "        Exit Sub" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    gMarkN = gMarkN + 1" & vbCrLf
    s = s & "    n = gMarkN" & vbCrLf
    s = s & "    v = kind & ""|"" & rule & ""|"" & sug" & vbCrLf
    ModPart24 = s
End Function

