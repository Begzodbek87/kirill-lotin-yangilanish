Function Nm2Part1()
    Dim s
    s = ""
    s = s & "Poytaxtda yosh dasturchilar uchun yangi o" & ChrW(699) & "quv markazi ochildi. Markazda talabalar dasturlash, ma" & ChrW(700) & "lumotlar bazasi va sun" & ChrW(700) & "iy intellekt asoslarini o" & ChrW(699) & "rganadi. Ochilish marosimida soha mutaxassislari ishtirok etdi." & vbCrLf
    s = s & "Markaz rahbarining so" & ChrW(699) & "zlariga ko" & ChrW(699) & "ra, mashg" & ChrW(699) & "ulotlar bepul bo" & ChrW(699) & "lib, ular haftada uch marta o" & ChrW(699) & "tkaziladi. Birinchi bosqichda yuz nafar talaba qabul qilinadi. Tanlov natijalari kelgusi oy boshida e" & ChrW(700) & "lon qilinadi." & vbCrLf
    s = s & "Mutaxassislarning ta" & ChrW(700) & "kidlashicha, o" & ChrW(699) & "zbek tilida ishlaydigan dasturlarga talab tobora ortib bormoqda. Ayniqsa, matnlarni avtomatik tahlil qiladigan, imlo xatolarini tuzatadigan va nutqni taniydigan dasturlar zarur. Bunday dasturlarni yaratish uchun katta hajmdagi til korpuslari kerak bo" & ChrW(699) & "ladi." & vbCrLf
    s = s & "Markaz kelgusida oliy ta" & ChrW(700) & "lim muassasalari bilan hamkorlikda o" & ChrW(699) & "zbek tili korpusini boyitish loyihasini boshlashni rejalashtirmoqda. Loyihada talabalar matnlarni yig" & ChrW(699) & "ish, tozalash va belgilash ishlarida qatnashadi." & vbCrLf
