Function ModPart17()
    Dim s
    s = ""
    s = s & "    Exit Sub" & vbCrLf
    s = s & "Fail:" & vbCrLf
    s = s & "    errNum = Err.Number" & vbCrLf
    s = s & "    errDesc = Err.Description" & vbCrLf
    s = s & "    EndUndo" & vbCrLf
    s = s & "    Application.ScreenUpdating = True" & vbCrLf
    s = s & "    MsgBox ""Xatolik "" & CStr(errNum) & "": "" & errDesc, vbExclamation, ""H/X tekshirish""" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "'------------------------------ H/X avtozamena ----------------------------" & vbCrLf
    s = s & "' Ro'yxat: %PUBLIC%\KirillLotinOCR\hxauto.txt (xato|to'g'ri)" & vbCrLf
    s = s & "Private Function HxSufForms(ByVal st As String) As String" & vbCrLf
    s = s & "    Dim lastc As String, r As String, sufs As Variant, i As Long" & vbCrLf
    s = s & "    lastc = Right$(st, 1)" & vbCrLf
    s = s & "    sufs = Array(""lar"", ""ni"", ""ning"", ""da"", ""dan"", ""li"", ""lik"", ""siz"", ""lari"", ""larni"", ""larga"", ""larning"")" & vbCrLf
    s = s & "    r = st" & vbCrLf
    s = s & "    For i = 0 To UBound(sufs)" & vbCrLf
    s = s & "        r = r & ""|"" & st & sufs(i)" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    If lastc = ""q"" Then" & vbCrLf
    s = s & "        r = r & ""|"" & st & ""qa""" & vbCrLf
    s = s & "    ElseIf lastc = ""k"" Then" & vbCrLf
    s = s & "        r = r & ""|"" & st & ""ka""" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        r = r & ""|"" & st & ""ga""" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    If InStr(""aeiou"", lastc) > 0 Then" & vbCrLf
    s = s & "        r = r & ""|"" & st & ""si""" & vbCrLf
    s = s & "    ElseIf lastc <> ""k"" And lastc <> ""q"" Then" & vbCrLf
    s = s & "        r = r & ""|"" & st & ""i""" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    HxSufForms = r" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "' mode 1 = qo'shish, 2 = o'chirish" & vbCrLf
    s = s & "Private Function HxAcPut(ByVal nm As String, ByVal vl As String, ByVal mode As Long) As Long" & vbCrLf
    s = s & "    Dim e As Object" & vbCrLf
    s = s & "    If Len(nm) = 0 Or Len(nm) > 31 Or nm = vl Then Exit Function" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    Set e = Nothing" & vbCrLf
    s = s & "    Set e = Application.AutoCorrect.Entries(nm)" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "    If mode = 1 Then" & vbCrLf
    s = s & "        If e Is Nothing Then" & vbCrLf
    s = s & "            Application.AutoCorrect.Entries.Add nm, vl" & vbCrLf
    s = s & "            If Err.Number = 0 Then HxAcPut = 1" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        If Not e Is Nothing Then" & vbCrLf
    s = s & "            If e.Value = vl Then" & vbCrLf
    s = s & "                e.Delete" & vbCrLf
    s = s & "                If Err.Number = 0 Then HxAcPut = 1" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function HxAcPair(ByVal w As String, ByVal r As String, ByVal cyr As Boolean, ByVal mode As Long) As Long" & vbCrLf
    s = s & "    Dim n As Long, aps As Variant, i As Long" & vbCrLf
    s = s & "    If cyr Then" & vbCrLf
    s = s & "        HxAcPair = HxAcPut(LatToCyr(w), LatToCyr(r), mode)" & vbCrLf
    s = s & "        Exit Function" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    If InStr(w, ""'"") > 0 Then" & vbCrLf
    s = s & "        aps = Array(""'"", ChrW(&H2019), ChrW(&H2BB), ChrW(&H2018))" & vbCrLf
    s = s & "        For i = 0 To 3" & vbCrLf
    s = s & "            n = n + HxAcPut(Replace(w, ""'"", aps(i)), Replace(r, ""'"", aps(i)), mode)" & vbCrLf
    s = s & "        Next i" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        n = HxAcPut(w, r, mode)" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    HxAcPair = n" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function HxAcRun(ByVal mode As Long, ByVal doCyr As Boolean) As Long" & vbCrLf
    s = s & "    Dim p As String, fso As Object, f As Object, ln As String, parts() As String" & vbCrLf
    s = s & "    Dim wf() As String, rf() As String, i As Long, cnt As Long, pass As Long, total As Long" & vbCrLf
    s = s & "    Dim skip As Object, d As Document, langs As Variant, cyrs As Variant, label As String" & vbCrLf
    s = s & "    p = Environ$(""PUBLIC"") & ""\KirillLotinOCR\hxauto.txt""" & vbCrLf
    ModPart17 = s
End Function

Function ModPart18()
    Dim s
    s = ""
    s = s & "    Set fso = CreateObject(""Scripting.FileSystemObject"")" & vbCrLf
    s = s & "    If Not fso.FileExists(p) Then" & vbCrLf
    s = s & "        HxAcRun = -1" & vbCrLf
    s = s & "        Exit Function" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    Set skip = CreateObject(""Scripting.Dictionary"")" & vbCrLf
    s = s & "    Set f = fso.OpenTextFile(p, 1, False, 0)" & vbCrLf
    s = s & "    Do While Not f.AtEndOfStream" & vbCrLf
    s = s & "        ln = Trim$(f.ReadLine)" & vbCrLf
    s = s & "        If Left$(ln, 1) = ""-"" Then skip(Mid$(ln, 2)) = 1" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    f.Close" & vbCrLf
    s = s & "    ' Word avtozamena ro'yxatlari tillar bo'yicha alohida: ingliz, o'zbek (lotin), rus, o'zbek (kirill)" & vbCrLf
    s = s & "    langs = Array(1033, 1091, 1049, 2115)" & vbCrLf
    s = s & "    cyrs = Array(False, False, True, True)" & vbCrLf
    s = s & "    Application.ScreenUpdating = False" & vbCrLf
    s = s & "    Set d = Documents.Add" & vbCrLf
    s = s & "    d.Content.Text = ""x""" & vbCrLf
    s = s & "    For pass = 0 To 3" & vbCrLf
    s = s & "        If CBool(cyrs(pass)) And Not doCyr Then GoTo NextPass" & vbCrLf
    s = s & "        On Error Resume Next" & vbCrLf
    s = s & "        d.Content.LanguageID = langs(pass)" & vbCrLf
    s = s & "        d.Range(0, 1).Select" & vbCrLf
    s = s & "        Err.Clear" & vbCrLf
    s = s & "        On Error GoTo 0" & vbCrLf
    s = s & "        If CBool(cyrs(pass)) Then label = ""kirill"" Else label = ""lotin""" & vbCrLf
    s = s & "        cnt = 0" & vbCrLf
    s = s & "        Set f = fso.OpenTextFile(p, 1, False, 0)" & vbCrLf
    s = s & "        Do While Not f.AtEndOfStream" & vbCrLf
    s = s & "            ln = Trim$(f.ReadLine)" & vbCrLf
