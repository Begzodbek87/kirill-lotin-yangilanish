    s = s & "    r.Select" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Public Sub ImPick()" & vbCrLf
