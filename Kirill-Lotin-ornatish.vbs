Function ModPart23()
    Dim s
    s = ""
    s = s & "    For Each b In ActiveDocument.Bookmarks" & vbCrLf
    s = s & "        If ImMarkNum(b.Name) > 0 Then" & vbCrLf
    s = s & "            If b.Range.Text = old Then col.Add b.Name" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next b" & vbCrLf
    s = s & "    Application.ScreenUpdating = False" & vbCrLf
    s = s & "    BeginUndo" & vbCrLf
