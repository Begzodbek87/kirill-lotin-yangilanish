    s = s & "            If e.Value = vl Then" & vbCrLf
    s = s & "                e.Delete" & vbCrLf
    s = s & "                If Err.Number = 0 Then HxAcPut = 1" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "End Function" & vbCrLf
