Function Nm6Part1()
    Dim s
    s = ""
    s = s & "Mening orzuyim" & vbCrLf
    s = s & "Har bir insonni orzusi bor. Mening orzuyim yaxshi dasturchi bolish. Men kichikligimdan kompyuterga qiziqardim. Maktabda informatika fanini juda yaxshi korardim." & vbCrLf
