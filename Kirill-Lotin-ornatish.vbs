Function ModPart28()
    Dim s
    s = ""
    s = s & "        s = Mid$(s, 2)" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    BibNorm = s" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function BibIsHead(ByVal t As String) As Boolean" & vbCrLf
    s = s & "    Dim s As String" & vbCrLf
    s = s & "    BibIsHead = False" & vbCrLf
    s = s & "    t = Replace(Replace(t, vbCr, """"), Chr$(7), """")" & vbCrLf
    s = s & "    If Len(t) > 70 Or Len(t) < 5 Then Exit Function" & vbCrLf
    s = s & "    s = BibNorm(CyrToLat(t))" & vbCrLf
    s = s & "    Select Case s" & vbCrLf
    s = s & "        Case ""foydalanilgan adabiyotlar"", ""foydalanilgan adabiyotlar royxati"", ""adabiyotlar royxati"", ""adabiyotlar"", _" & vbCrLf
    s = s & "             ""foydalanilgan adabiyotlar va manbalar"", ""foydalanilgan manbalar"", ""references"", ""bibliography"", _" & vbCrLf
    s = s & "             ""list of references"", ""literature""" & vbCrLf
    s = s & "            BibIsHead = True" & vbCrLf
    s = s & "    End Select" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function BibFindList(ByRef lStart As Long, ByRef lEnd As Long) As Boolean" & vbCrLf
    s = s & "    Dim para As Paragraph, hdrEnd As Long, rr As Range, t As String, s As String" & vbCrLf
    s = s & "    BibFindList = False" & vbCrLf
    s = s & "    If Selection.Start <> Selection.End Then" & vbCrLf
    s = s & "        lStart = Selection.Paragraphs(1).Range.Start" & vbCrLf
    s = s & "        lEnd = Selection.Paragraphs(Selection.Paragraphs.Count).Range.End" & vbCrLf
    s = s & "        BibFindList = (lEnd > lStart)" & vbCrLf
    s = s & "        Exit Function" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    hdrEnd = -1" & vbCrLf
    s = s & "    For Each para In ActiveDocument.Paragraphs" & vbCrLf
    s = s & "        t = para.Range.Text" & vbCrLf
    s = s & "        If Len(t) < 80 Then" & vbCrLf
    s = s & "            If BibIsHead(t) Then hdrEnd = para.Range.End" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next para" & vbCrLf
    s = s & "    If hdrEnd < 0 Then Exit Function" & vbCrLf
    s = s & "    Set rr = ActiveDocument.Range(hdrEnd, ActiveDocument.Content.End)" & vbCrLf
    s = s & "    lStart = hdrEnd" & vbCrLf
    s = s & "    lEnd = hdrEnd" & vbCrLf
    s = s & "    For Each para In rr.Paragraphs" & vbCrLf
    s = s & "        t = para.Range.Text" & vbCrLf
    s = s & "        If Len(Trim$(Replace(Replace(t, vbCr, """"), Chr$(7), """"))) > 0 Then" & vbCrLf
    s = s & "            If para.OutlineLevel <= 3 Then Exit For" & vbCrLf
    s = s & "            s = BibNorm(CyrToLat(Left$(t, 40)))" & vbCrLf
    s = s & "            If Left$(s, 5) = ""ilova"" Then Exit For" & vbCrLf
    s = s & "            lEnd = para.Range.End" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next para" & vbCrLf
    s = s & "    BibFindList = (lEnd > lStart)" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function BibClean(ByVal t As String) As String" & vbCrLf
    s = s & "    Do While Len(t) > 0 And (Right$(t, 1) = vbCr Or Right$(t, 1) = Chr$(7))" & vbCrLf
    s = s & "        t = Left$(t, Len(t) - 1)" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    t = Replace(Replace(t, vbCr, Chr$(11)), vbLf, Chr$(11))" & vbCrLf
    s = s & "    BibClean = Replace(t, vbTab, "" "")" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Public Sub Adabiyotlar()" & vbCrLf
    s = s & "    Dim lS As Long, lE As Long, root As String, fso As Object, f As Object, wsh As Object, rc As Long" & vbCrLf
    s = s & "    Dim inF As String, outF As String, para As Paragraph, t As String, nE As Long, nB As Long" & vbCrLf
    s = s & "    Dim bS() As Long, ans As String, mode As String, digr As String, ynd As Long, fmtOn As String" & vbCrLf
    s = s & "    Dim ln As String, parts() As String, items As Collection, v As Variant, r As Range" & vbCrLf
    s = s & "    Dim rep As String, composed As String, hdrs As Collection, nLines As Long, idx As Long" & vbCrLf
    s = s & "    Dim fmt As ParagraphFormat, fName As String, fSize As Single, firstP As Paragraph, nEdit As Long" & vbCrLf
    s = s & "    Dim orig As Document, rd As Document, preview As String, errNum As Long, errDesc As String" & vbCrLf
    s = s & "    Dim pr As Paragraph" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    If Not CheckAct() Then Exit Sub" & vbCrLf
    s = s & "    If Documents.Count = 0 Then Exit Sub" & vbCrLf
    s = s & "    root = Environ$(""PUBLIC"") & ""\KirillLotinOCR""" & vbCrLf
    s = s & "    Set fso = CreateObject(""Scripting.FileSystemObject"")" & vbCrLf
    s = s & "    If Not fso.FileExists(root & ""\oak_biblio.js"") Then" & vbCrLf
    s = s & "        MsgBox ""Adabiyotlar vositasi topilmadi. Kirill-Lotin-ornatish.vbs ni qayta ishga tushiring."", vbExclamation, ""Adabiyotlar ro'yxati""" & vbCrLf
    s = s & "        Exit Sub" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    If Not BibFindList(lS, lE) Then" & vbCrLf
    s = s & "        MsgBox ""Adabiyotlar ro'yxati topilmadi."" & vbCrLf & vbCrLf & _" & vbCrLf
    s = s & "               ""Ro'yxat sarlavhasi ('Foydalanilgan adabiyotlar' yoki 'Adabiyotlar ro'yxati') bo'lishi kerak,"" & vbCrLf & _" & vbCrLf
    ModPart28 = s
End Function

Function ModPart29()
