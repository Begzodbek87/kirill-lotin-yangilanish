    s = s & "    h = 7" & vbCrLf
    s = s & "    For i = 1 To Len(s)" & vbCrLf
    s = s & "        h = h * mult + AscW(Mid$(s, i, 1))" & vbCrLf
    s = s & "        h = h - Int(h / p) * p" & vbCrLf
    s = s & "    Next i" & vbCrLf
    ModPart11 = s
End Function

