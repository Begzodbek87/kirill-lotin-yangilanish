Function AddRibbon(dotm, rootDir, ver)
    Dim d, rc, v
    AddRibbon = False
    On Error Resume Next
    d = rootDir & "\ribbon"
    If Not fso.FolderExists(d) Then fso.CreateFolder d
    If fso.FileExists(d & "\ribbon-xato.txt") Then fso.DeleteFile d & "\ribbon-xato.txt", True
    v = 14
    If ver = "12.0" Then v = 12
    rc = sh.Run("powershell.exe -NoProfile -ExecutionPolicy Bypass -File """ & d & "\ribbon.ps1"" -Dotm """ & dotm & """ -Dir """ & d & """ -Ver " & v, 0, True)
    If Err.Number = 0 Then
        If rc = 0 Then AddRibbon = True
    End If
    Err.Clear
End Function

Sub WriteUtf8(p, t)
    Dim st
    Set st = CreateObject("ADODB.Stream")
    st.Type = 2
    st.Charset = "utf-8"
    st.Open
    st.WriteText t
    st.SaveToFile p, 2
    st.Close
End Sub


Sub WriteFile(p, t)
    Dim f
    Set f = fso.CreateTextFile(p, True, False)
    f.Write t
    f.Close
End Sub

