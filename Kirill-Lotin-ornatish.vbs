Sub WriteIcons(root)
    Dim d, lines, i, p, el, st, nm
    On Error Resume Next
    Set d = CreateObject("MSXML2.DOMDocument")
    lines = Split(IcoText(), vbCrLf)
    For i = 0 To UBound(lines)
        p = InStr(lines(i), ":")
        If p > 1 Then
            nm = Left(lines(i), p - 1)
            Set el = d.createElement("b")
            el.dataType = "bin.base64"
            el.Text = Mid(lines(i), p + 1)
            Set st = CreateObject("ADODB.Stream")
            st.Type = 1
            st.Open
            st.Write el.nodeTypedValue
            st.SaveToFile root & "\" & nm & ".ico", 2
            st.Close
        End If
    Next
End Sub

Function AddRibbon(dotm, rootDir, ver)
    Dim d, rc, v, tryN
    AddRibbon = False
    On Error Resume Next
    d = rootDir & "\ribbon"
    If Not fso.FolderExists(d) Then fso.CreateFolder d
    If fso.FileExists(d & "\ribbon-xato.txt") Then fso.DeleteFile d & "\ribbon-xato.txt", True
    v = 14
    If ver = "12.0" Then v = 12
    For tryN = 1 To 4
        rc = sh.Run("powershell.exe -NoProfile -ExecutionPolicy Bypass -File """ & d & "\ribbon.ps1"" -Dotm """ & dotm & """ -Dir """ & d & """ -Ver " & v, 0, True)
        If Err.Number = 0 Then
            If rc = 0 Then
                AddRibbon = True
                Exit For
            End If
        End If
        Err.Clear
        WaitWordGone
        WScript.Sleep 3000
    Next
    Err.Clear
End Function

Sub WriteUtf8(p, t)
    Dim st
    Set st = CreateObject("ADODB.Stream")
    st.Type = 2
    st.Charset = "utf-8"
    st.Open
    st.WriteText t
    st.SaveToFile p, 2
    st.Close
End Sub


Sub WriteFile(p, t)
    Dim f
    Set f = fso.CreateTextFile(p, True, False)
    f.Write t
    f.Close
End Sub

