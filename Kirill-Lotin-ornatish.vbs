Function ModPart25()
    Dim s
    s = ""
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function ImFindAt(ByVal pos As Long) As String" & vbCrLf
    s = s & "    Dim b As Bookmark" & vbCrLf
    s = s & "    ImFindAt = """"" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "    For Each b In ActiveDocument.Bookmarks" & vbCrLf
    s = s & "        If ImMarkNum(b.Name) > 0 Then" & vbCrLf
    s = s & "            If b.Start <= pos And b.End >= pos Then ImFindAt = b.Name" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next b" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Public Sub ImJoriy()" & vbCrLf
    s = s & "    Dim pos As Long, nm As String, wr As Range, c As String, k As Long, cyr As Boolean, ws As Long, we As Long" & vbCrLf
    s = s & "    If Not CheckAct() Then Exit Sub" & vbCrLf
    s = s & "    If Documents.Count = 0 Then Exit Sub" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    pos = Selection.Start" & vbCrLf
    s = s & "    nm = ImFindAt(pos)" & vbCrLf
    s = s & "    If Len(nm) = 0 And Selection.End <> Selection.Start Then nm = ImFindAt(Selection.End)" & vbCrLf
    s = s & "    If Len(nm) = 0 Then" & vbCrLf
    s = s & "        ' belgilanmagan: shu so'zning o'zini hozir tekshiramiz" & vbCrLf
    s = s & "        Set wr = Selection.Range.Duplicate" & vbCrLf
    s = s & "        If Selection.Start = Selection.End Then" & vbCrLf
    s = s & "            Set wr = Selection.Words(1)" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "        Do While wr.End > wr.Start" & vbCrLf
    s = s & "            c = wr.Characters(wr.Characters.Count).Text" & vbCrLf
    s = s & "            If c = "" "" Or c = Chr$(160) Or c = ""."" Or c = "","" Or c = "";"" Or c = "":"" Or c = ""!"" Or c = ""?"" Or c = "")"" Or c = """""""" Or c = vbCr Or c = Chr$(7) Or c = Chr$(9) Then" & vbCrLf
    s = s & "                wr.MoveEnd 1, -1" & vbCrLf
    s = s & "            Else" & vbCrLf
    s = s & "                Exit Do" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        Loop" & vbCrLf
    s = s & "        If wr.End <= wr.Start Then" & vbCrLf
    s = s & "            MsgBox ""So'z ustiga bosing yoki so'zni belgilang."", vbInformation, ""Imlo takliflari""" & vbCrLf
    s = s & "            Exit Sub" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "        ws = wr.Start" & vbCrLf
    s = s & "        we = wr.End" & vbCrLf
    s = s & "        For k = 1 To Len(wr.Text)" & vbCrLf
    s = s & "            If AscW(Mid$(wr.Text, k, 1)) >= 1024 And AscW(Mid$(wr.Text, k, 1)) <= 1279 Then cyr = True" & vbCrLf
    s = s & "        Next k" & vbCrLf
    s = s & "        If cyr Then" & vbCrLf
    s = s & "            MsgBox ""Bu so'z kirill alifbosida. Imlo tekshiruvi lotin alifbosidagi matn uchun ishlaydi:"" & vbCrLf & _" & vbCrLf
    s = s & "                   ""avval matnni 'Kirill > Lotin' bilan o'giring, so'ng tekshiring."", vbInformation, ""Imlo takliflari""" & vbCrLf
    s = s & "            Exit Sub" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "        Selection.SetRange ws, we" & vbCrLf
    s = s & "        gImQuick = True" & vbCrLf
    s = s & "        ImloTekshirish" & vbCrLf
    s = s & "        gImQuick = False" & vbCrLf
    s = s & "        Selection.SetRange ws, ws" & vbCrLf
    s = s & "        nm = ImFindAt(ws)" & vbCrLf
    s = s & "        If Len(nm) = 0 Then" & vbCrLf
    s = s & "            MsgBox ""'"" & wr.Text & ""' so'zida imlo xatosi topilmadi."", vbInformation, ""Imlo takliflari""" & vbCrLf
    s = s & "            Exit Sub" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    ImShowPopup nm" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Public Sub ImTozalash()" & vbCrLf
    s = s & "    Dim ans As Long, scope As Range" & vbCrLf
    s = s & "    If Documents.Count = 0 Then Exit Sub" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    If Selection.Start <> Selection.End Then" & vbCrLf
    s = s & "        Set scope = Selection.Range" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        Set scope = ActiveDocument.Content" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    ans = MsgBox(""Tekshiruv belgilari (sariq/pushti ranglar va takliflar) olib tashlansinmi?"" & vbCrLf & _" & vbCrLf
    s = s & "                 ""Yashil (tuzatilgan) so'zlar ranggi ham olib tashlanadi."" & vbCrLf & vbCrLf & _" & vbCrLf
    s = s & "                 ""Diqqat: tanlangan qism (yoki butun hujjat) dagi barcha belgilash (highlight) rangi o'chadi."", _" & vbCrLf
    s = s & "                 vbYesNo + vbQuestion, ""Belgilarni tozalash"")" & vbCrLf
    s = s & "    If ans <> vbYes Then Exit Sub" & vbCrLf
    s = s & "    BeginUndo" & vbCrLf
    ModPart25 = s
End Function

