Function ModPart2()
    Dim s
    s = ""
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function TAp() As String" & vbCrLf
    s = s & "    Select Case StyleNo()" & vbCrLf
    s = s & "        Case 2: TAp = ""'""" & vbCrLf
    s = s & "        Case 3: TAp = ChrW(&H2019)" & vbCrLf
    s = s & "        Case Else: TAp = ChrW(&H2BC)" & vbCrLf
    s = s & "    End Select" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "'------------------------------ Yordamchilar ------------------------------" & vbCrLf
    s = s & "Private Function CodeAt(ByVal s As String, ByVal i As Long) As Long" & vbCrLf
    s = s & "    If i < 1 Or i > Len(s) Then" & vbCrLf
    s = s & "        CodeAt = 0" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        CodeAt = AscW(Mid$(s, i, 1))" & vbCrLf
    s = s & "        If CodeAt < 0 Then CodeAt = CodeAt + 65536" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function LowerCyr(ByVal c As Long) As Long" & vbCrLf
    s = s & "    Select Case c" & vbCrLf
    s = s & "        Case &H410 To &H42F: LowerCyr = c + 32" & vbCrLf
    s = s & "        Case &H401: LowerCyr = &H451" & vbCrLf
    s = s & "        Case &H40E: LowerCyr = &H45E" & vbCrLf
    s = s & "        Case &H49A: LowerCyr = &H49B" & vbCrLf
    s = s & "        Case &H492: LowerCyr = &H493" & vbCrLf
    s = s & "        Case &H4B2: LowerCyr = &H4B3" & vbCrLf
    s = s & "        Case Else: LowerCyr = c" & vbCrLf
    s = s & "    End Select" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function UpperCyr(ByVal lc As Long) As Long" & vbCrLf
    s = s & "    Select Case lc" & vbCrLf
    s = s & "        Case &H430 To &H44F: UpperCyr = lc - 32" & vbCrLf
    s = s & "        Case &H451: UpperCyr = &H401" & vbCrLf
    s = s & "        Case &H45E: UpperCyr = &H40E" & vbCrLf
    s = s & "        Case &H49B: UpperCyr = &H49A" & vbCrLf
    s = s & "        Case &H493: UpperCyr = &H492" & vbCrLf
    s = s & "        Case &H4B3: UpperCyr = &H4B2" & vbCrLf
    s = s & "        Case Else: UpperCyr = lc" & vbCrLf
    s = s & "    End Select" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function IsCyrLetter(ByVal c As Long) As Boolean" & vbCrLf
    s = s & "    Dim l As Long" & vbCrLf
    s = s & "    l = LowerCyr(c)" & vbCrLf
    s = s & "    IsCyrLetter = ((l >= &H430 And l <= &H44F) Or l = &H451 Or l = &H45E Or l = &H49B Or l = &H493 Or l = &H4B3)" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function IsUpperCyr(ByVal c As Long) As Boolean" & vbCrLf
    s = s & "    IsUpperCyr = IsCyrLetter(c) And (LowerCyr(c) <> c)" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function IsCyrVowel(ByVal lc As Long) As Boolean" & vbCrLf
    s = s & "    Select Case lc" & vbCrLf
    s = s & "        Case &H430, &H435, &H451, &H438, &H43E, &H443, &H45E, &H44D, &H44E, &H44F" & vbCrLf
    s = s & "            IsCyrVowel = True" & vbCrLf
    s = s & "        Case Else" & vbCrLf
    s = s & "            IsCyrVowel = False" & vbCrLf
    s = s & "    End Select" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function CS(ByVal lc As Long, ByVal up As Boolean) As String" & vbCrLf
    s = s & "    If up Then" & vbCrLf
    s = s & "        CS = ChrW(UpperCyr(lc))" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        CS = ChrW(lc)" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function IsApos(ByVal ch As String) As Boolean" & vbCrLf
    s = s & "    Dim c As Long" & vbCrLf
    s = s & "    If Len(ch) = 0 Then Exit Function" & vbCrLf
    s = s & "    c = CodeAt(ch, 1)" & vbCrLf
    s = s & "    IsApos = (c = 39 Or c = 96 Or c = 180 Or c = &H2BB Or c = &H2BC Or c = &H2B9 Or c = &H2018 Or c = &H2019 Or c = &H2032)" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function IsLat(ByVal ch As String) As Boolean" & vbCrLf
    s = s & "    If Len(ch) = 0 Then Exit Function" & vbCrLf
    ModPart2 = s
End Function

Function ModPart3()
    Dim s
    s = ""
    s = s & "    IsLat = (ch Like ""[A-Za-z]"")" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "'----------------------------- KIRILL -> LOTIN ----------------------------" & vbCrLf
    s = s & "Public Function CyrToLat(ByVal s As String) As String" & vbCrLf
    s = s & "    Dim i As Long, n As Long, c As Long, lc As Long, pc As Long, nc As Long" & vbCrLf
    s = s & "    Dim b As String, res As String" & vbCrLf
    s = s & "    Dim up As Boolean, multi As Boolean, neigh As Boolean, skip As Boolean" & vbCrLf
    s = s & "    n = Len(s)" & vbCrLf
    s = s & "    For i = 1 To n" & vbCrLf
    s = s & "        c = CodeAt(s, i)" & vbCrLf
    s = s & "        lc = LowerCyr(c)" & vbCrLf
    s = s & "        up = (lc <> c)" & vbCrLf
    s = s & "        pc = CodeAt(s, i - 1)" & vbCrLf
    s = s & "        nc = CodeAt(s, i + 1)" & vbCrLf
    s = s & "        b = """"" & vbCrLf
    s = s & "        skip = False" & vbCrLf
    s = s & "        Select Case lc" & vbCrLf
    s = s & "            Case &H430: b = ""a""" & vbCrLf
    s = s & "            Case &H431: b = ""b""" & vbCrLf
    s = s & "            Case &H432: b = ""v""" & vbCrLf
    s = s & "            Case &H433: b = ""g""" & vbCrLf
    s = s & "            Case &H434: b = ""d""" & vbCrLf
    s = s & "            Case &H436: b = ""j""" & vbCrLf
    s = s & "            Case &H437: b = ""z""" & vbCrLf
    s = s & "            Case &H438: b = ""i""" & vbCrLf
    s = s & "            Case &H439: b = ""y""" & vbCrLf
    s = s & "            Case &H43A: b = ""k""" & vbCrLf
    s = s & "            Case &H43B: b = ""l""" & vbCrLf
    s = s & "            Case &H43C: b = ""m""" & vbCrLf
    s = s & "            Case &H43D: b = ""n""" & vbCrLf
    s = s & "            Case &H43E: b = ""o""" & vbCrLf
    s = s & "            Case &H43F: b = ""p""" & vbCrLf
    s = s & "            Case &H440: b = ""r""" & vbCrLf
    s = s & "            Case &H441: b = ""s""" & vbCrLf
    s = s & "            Case &H442: b = ""t""" & vbCrLf
    s = s & "            Case &H443: b = ""u""" & vbCrLf
    s = s & "            Case &H444: b = ""f""" & vbCrLf
    s = s & "            Case &H445: b = ""x""" & vbCrLf
    s = s & "            Case &H447: b = ""ch""" & vbCrLf
    s = s & "            Case &H448: b = ""sh""" & vbCrLf
    s = s & "            Case &H449: b = ""shch""" & vbCrLf
    s = s & "            Case &H44B: b = ""i""" & vbCrLf
    s = s & "            Case &H44D: b = ""e""" & vbCrLf
    s = s & "            Case &H44E: b = ""yu""" & vbCrLf
    s = s & "            Case &H44F: b = ""ya""" & vbCrLf
    s = s & "            Case &H451: b = ""yo""" & vbCrLf
    s = s & "            Case &H45E: b = ""o"" & OAp()" & vbCrLf
    s = s & "            Case &H493: b = ""g"" & OAp()" & vbCrLf
    s = s & "            Case &H49B: b = ""q""" & vbCrLf
    s = s & "            Case &H4B3: b = ""h""" & vbCrLf
    s = s & "            Case &H435" & vbCrLf
    s = s & "                If pc = &H44A Or pc = &H42A Then" & vbCrLf
    s = s & "                    If Len(res) > 0 Then" & vbCrLf
    s = s & "                        If Right$(res, 1) = TAp() Then res = Left$(res, Len(res) - 1)" & vbCrLf
    s = s & "                    End If" & vbCrLf
    s = s & "                    b = ""ye""" & vbCrLf
    s = s & "                ElseIf (Not IsCyrLetter(pc)) Or IsCyrVowel(LowerCyr(pc)) Then" & vbCrLf
    s = s & "                    b = ""ye""" & vbCrLf
    s = s & "                Else" & vbCrLf
    s = s & "                    b = ""e""" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            Case &H446" & vbCrLf
    s = s & "                ' so'z boshi, oxiri yoki undoshdan keyin: s (sex, aksiya, kvars); unlidan keyin: ts (litsey)" & vbCrLf
    s = s & "                If (Not IsCyrLetter(pc)) Or (Not IsCyrLetter(nc)) Or (Not IsCyrVowel(LowerCyr(pc))) Then" & vbCrLf
    s = s & "                    b = ""s""" & vbCrLf
    s = s & "                Else" & vbCrLf
    s = s & "                    b = ""ts""" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            Case &H44A" & vbCrLf
    s = s & "                ' o' dan keyin tutuq yozilmaydi: mo'jiza (imlo qoidalari, 32-band)" & vbCrLf
    s = s & "                If LowerCyr(pc) <> &H45E Then res = res & TAp()" & vbCrLf
    s = s & "                skip = True" & vbCrLf
    s = s & "            Case &H44C" & vbCrLf
    s = s & "                skip = True" & vbCrLf
    s = s & "            Case Else" & vbCrLf
    s = s & "                res = res & Mid$(s, i, 1)" & vbCrLf
    s = s & "                skip = True" & vbCrLf
    s = s & "        End Select" & vbCrLf
    s = s & "        If Not skip Then" & vbCrLf
    ModPart3 = s
End Function

Function ModPart4()
    Dim s
    s = ""
    s = s & "            If up Then" & vbCrLf
    s = s & "                multi = (Len(b) >= 2) And (b Like ""[a-z][a-z]*"")" & vbCrLf
    s = s & "                neigh = IsUpperCyr(pc) Or IsUpperCyr(nc)" & vbCrLf
    s = s & "                If multi And neigh Then" & vbCrLf
    s = s & "                    b = UCase$(b)" & vbCrLf
    s = s & "                Else" & vbCrLf
    s = s & "                    b = UCase$(Left$(b, 1)) & Mid$(b, 2)" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "            res = res & b" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    CyrToLat = res" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "'----------------------------- LOTIN -> KIRILL ----------------------------" & vbCrLf
    s = s & "Public Function LatToCyr(ByVal s As String) As String" & vbCrLf
    s = s & "    Dim i As Long, n As Long" & vbCrLf
    s = s & "    Dim ch As String, lo As String, nx As String, nl As String, pv As String, pp As String" & vbCrLf
    s = s & "    Dim up As Boolean, res As String, p As String" & vbCrLf
    s = s & "    Dim code As Long, startW As Boolean, vowel As Boolean" & vbCrLf
    s = s & "    n = Len(s)" & vbCrLf
    s = s & "    i = 1" & vbCrLf
    s = s & "    Do While i <= n" & vbCrLf
    s = s & "        ch = Mid$(s, i, 1)" & vbCrLf
    s = s & "        lo = LCase$(ch)" & vbCrLf
    s = s & "        up = (ch <> lo)" & vbCrLf
    s = s & "        If i > 1 Then pv = Mid$(s, i - 1, 1) Else pv = """"" & vbCrLf
    s = s & "        If i > 2 Then pp = LCase$(Mid$(s, i - 2, 1)) Else pp = """"" & vbCrLf
    s = s & "        If i < n Then nx = Mid$(s, i + 1, 1) Else nx = """"" & vbCrLf
    s = s & "        nl = LCase$(nx)" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        If IsApos(ch) Then" & vbCrLf
    s = s & "            ' harflar orasidagi apostrof - tutuq belgisi" & vbCrLf
    s = s & "            If IsLat(pv) And IsLat(nx) Then" & vbCrLf
    s = s & "                res = res & ChrW(&H44A)" & vbCrLf
    s = s & "            Else" & vbCrLf
    s = s & "                res = res & ch" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        ElseIf Not IsLat(ch) Then" & vbCrLf
    s = s & "            res = res & ch" & vbCrLf
    s = s & "        ElseIf (lo = ""o"" Or lo = ""g"") And IsApos(nx) Then" & vbCrLf
    s = s & "            If lo = ""o"" Then" & vbCrLf
    s = s & "                res = res & CS(&H45E, up)" & vbCrLf
    s = s & "            Else" & vbCrLf
    s = s & "                res = res & CS(&H493, up)" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "            i = i + 1" & vbCrLf
    s = s & "        ElseIf lo = ""s"" And nl = ""h"" Then" & vbCrLf
    s = s & "            res = res & CS(&H448, up)" & vbCrLf
    s = s & "            i = i + 1" & vbCrLf
    s = s & "        ElseIf lo = ""c"" And nl = ""h"" Then" & vbCrLf
    s = s & "            res = res & CS(&H447, up)" & vbCrLf
    s = s & "            i = i + 1" & vbCrLf
    s = s & "        ElseIf lo = ""n"" And nl = ""g"" And Not IsApos(Mid$(s, i + 2, 1)) Then" & vbCrLf
    s = s & "            res = res & CS(&H43D, up) & CS(&H433, (nx <> nl))" & vbCrLf
    s = s & "            i = i + 1" & vbCrLf
    s = s & "        ElseIf lo = ""y"" And nl = ""o"" Then" & vbCrLf
    s = s & "            res = res & CS(&H451, up)" & vbCrLf
    s = s & "            i = i + 1" & vbCrLf
    s = s & "        ElseIf lo = ""y"" And nl = ""u"" Then" & vbCrLf
    s = s & "            res = res & CS(&H44E, up)" & vbCrLf
    s = s & "            i = i + 1" & vbCrLf
    s = s & "        ElseIf lo = ""y"" And nl = ""a"" Then" & vbCrLf
    s = s & "            res = res & CS(&H44F, up)" & vbCrLf
    s = s & "            i = i + 1" & vbCrLf
    s = s & "        ElseIf lo = ""y"" And nl = ""e"" Then" & vbCrLf
    s = s & "            p = LCase$(pv)" & vbCrLf
    s = s & "            startW = Not (IsLat(pv) Or IsApos(pv))" & vbCrLf
    s = s & "            vowel = False" & vbCrLf
    s = s & "            If Len(p) = 1 Then" & vbCrLf
    s = s & "                If InStr(""aeiou"", p) > 0 Then vowel = True" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "            If IsApos(pv) And pp = ""o"" Then vowel = True" & vbCrLf
    s = s & "            If startW Or vowel Then" & vbCrLf
    s = s & "                res = res & CS(&H435, up)" & vbCrLf
    s = s & "            Else" & vbCrLf
    s = s & "                res = res & ChrW(&H44A) & CS(&H435, (nx <> nl))" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "            i = i + 1" & vbCrLf
    ModPart4 = s
End Function

Function ModPart5()
    Dim s
    s = ""
    s = s & "        ElseIf lo = ""e"" Then" & vbCrLf
    s = s & "            If IsLat(pv) Or IsApos(pv) Then" & vbCrLf
    s = s & "                res = res & CS(&H435, up)" & vbCrLf
    s = s & "            Else" & vbCrLf
    s = s & "                res = res & CS(&H44D, up)" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        Else" & vbCrLf
    s = s & "            code = 0" & vbCrLf
    s = s & "            Select Case lo" & vbCrLf
    s = s & "                Case ""a"": code = &H430" & vbCrLf
    s = s & "                Case ""b"": code = &H431" & vbCrLf
    s = s & "                Case ""v"", ""w"": code = &H432" & vbCrLf
    s = s & "                Case ""g"": code = &H433" & vbCrLf
    s = s & "                Case ""d"": code = &H434" & vbCrLf
    s = s & "                Case ""j"": code = &H436" & vbCrLf
    s = s & "                Case ""z"": code = &H437" & vbCrLf
    s = s & "                Case ""i"": code = &H438" & vbCrLf
    s = s & "                Case ""y"": code = &H439" & vbCrLf
    s = s & "                Case ""k"": code = &H43A" & vbCrLf
    s = s & "                Case ""l"": code = &H43B" & vbCrLf
    s = s & "                Case ""m"": code = &H43C" & vbCrLf
    s = s & "                Case ""n"": code = &H43D" & vbCrLf
    s = s & "                Case ""o"": code = &H43E" & vbCrLf
    s = s & "                Case ""p"": code = &H43F" & vbCrLf
    s = s & "                Case ""r"": code = &H440" & vbCrLf
    s = s & "                Case ""s"": code = &H441" & vbCrLf
    s = s & "                Case ""t"": code = &H442" & vbCrLf
    s = s & "                Case ""u"": code = &H443" & vbCrLf
    s = s & "                Case ""f"": code = &H444" & vbCrLf
    s = s & "                Case ""x"": code = &H445" & vbCrLf
    s = s & "                Case ""c"": code = &H446" & vbCrLf
    s = s & "                Case ""q"": code = &H49B" & vbCrLf
    s = s & "                Case ""h"": code = &H4B3" & vbCrLf
    s = s & "            End Select" & vbCrLf
    s = s & "            If code = 0 Then" & vbCrLf
    s = s & "                res = res & ch" & vbCrLf
    s = s & "            Else" & vbCrLf
    s = s & "                res = res & CS(code, up)" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "        i = i + 1" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    LatToCyr = res" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "'------------------------------ Word bilan ishlash ------------------------" & vbCrLf
    s = s & "Private Function IsLetterCode(ByVal c As Long) As Boolean" & vbCrLf
    s = s & "    IsLetterCode = ((c >= 65 And c <= 90) Or (c >= 97 And c <= 122) Or (c >= &H400 And c <= &H4FF))" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function IsTokChar(ByVal c As Long) As Boolean" & vbCrLf
    s = s & "    IsTokChar = (IsLetterCode(c) Or c = 39 Or c = 96 Or c = 180 Or c = &H2BB Or c = &H2BC Or c = &H2B9 Or c = &H2018 Or c = &H2019 Or c = &H2032)" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function ConvertToken(ByVal tok As String, ByVal toLatin As Boolean) As String" & vbCrLf
    s = s & "    If toLatin Then" & vbCrLf
    s = s & "        ConvertToken = CyrToLat(tok)" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        ConvertToken = LatToCyr(tok)" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "' Bitta abzats (yoki uning bir qismi) ichidagi so'zlarni o'giradi" & vbCrLf
    s = s & "Private Sub ConvertPiece(ByVal pr As Range, ByVal toLatin As Boolean)" & vbCrLf
    s = s & "    Dim txt As String, basePos As Long, n As Long, i As Long, j As Long, k As Long" & vbCrLf
    s = s & "    Dim s As Long, e As Long, cnt As Long" & vbCrLf
    s = s & "    Dim tok As String, conv As String" & vbCrLf
    s = s & "    Dim tr As Range" & vbCrLf
    s = s & "    Dim tS() As Long, tE() As Long" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    If pr.Fields.Count > 0 Then" & vbCrLf
    s = s & "        ConvertByWords pr, toLatin" & vbCrLf
    s = s & "        Exit Sub" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    txt = pr.Text" & vbCrLf
    s = s & "    basePos = pr.Start" & vbCrLf
    s = s & "    n = Len(txt)" & vbCrLf
    s = s & "    If n = 0 Then Exit Sub" & vbCrLf
    s = s & "    ReDim tS(1 To n)" & vbCrLf
    ModPart5 = s
End Function

Function ModPart6()
    Dim s
    s = ""
    s = s & "    ReDim tE(1 To n)" & vbCrLf
    s = s & "    cnt = 0" & vbCrLf
    s = s & "    i = 1" & vbCrLf
    s = s & "    Do While i <= n" & vbCrLf
    s = s & "        If IsTokChar(CodeAt(txt, i)) Then" & vbCrLf
    s = s & "            j = i" & vbCrLf
    s = s & "            Do While j < n" & vbCrLf
    s = s & "                If IsTokChar(CodeAt(txt, j + 1)) Then" & vbCrLf
    s = s & "                    j = j + 1" & vbCrLf
    s = s & "                Else" & vbCrLf
    s = s & "                    Exit Do" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            Loop" & vbCrLf
    s = s & "            s = i" & vbCrLf
    s = s & "            e = j" & vbCrLf
    s = s & "            Do While s <= e" & vbCrLf
    s = s & "                If IsLetterCode(CodeAt(txt, s)) Then Exit Do" & vbCrLf
    s = s & "                s = s + 1" & vbCrLf
    s = s & "            Loop" & vbCrLf
    s = s & "            Do While e >= s" & vbCrLf
    s = s & "                If IsLetterCode(CodeAt(txt, e)) Then Exit Do" & vbCrLf
    s = s & "                e = e - 1" & vbCrLf
    s = s & "            Loop" & vbCrLf
    s = s & "            If e >= s Then" & vbCrLf
    s = s & "                cnt = cnt + 1" & vbCrLf
    s = s & "                tS(cnt) = s" & vbCrLf
    s = s & "                tE(cnt) = e" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "            i = j + 1" & vbCrLf
    s = s & "        Else" & vbCrLf
    s = s & "            i = i + 1" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    For k = cnt To 1 Step -1" & vbCrLf
    s = s & "        tok = Mid$(txt, tS(k), tE(k) - tS(k) + 1)" & vbCrLf
    s = s & "        conv = ConvertToken(tok, toLatin)" & vbCrLf
    s = s & "        If conv <> tok Then" & vbCrLf
    s = s & "            Set tr = pr.Duplicate" & vbCrLf
    s = s & "            tr.SetRange basePos + tS(k) - 1, basePos + tE(k)" & vbCrLf
    s = s & "            If tr.Text = tok Then tr.Text = conv" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next k" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "' Maydonlar (fields) bor abzatslar uchun - Word'ning ""Words"" to'plami orqali" & vbCrLf
    s = s & "Private Sub ConvertByWords(ByVal pr As Range, ByVal toLatin As Boolean)" & vbCrLf
    s = s & "    Dim i As Long, w As Range, tok As String, conv As String, lastc As String" & vbCrLf
    s = s & "    For i = pr.Words.Count To 1 Step -1" & vbCrLf
    s = s & "        Set w = pr.Words(i)" & vbCrLf
    s = s & "        tok = w.Text" & vbCrLf
    s = s & "        Do While Len(tok) > 0" & vbCrLf
    s = s & "            lastc = Right$(tok, 1)" & vbCrLf
    s = s & "            If lastc = "" "" Or lastc = vbCr Or lastc = vbTab Or lastc = Chr$(7) Or lastc = Chr$(11) Or lastc = Chr$(12) Or lastc = Chr$(160) Then" & vbCrLf
    s = s & "                tok = Left$(tok, Len(tok) - 1)" & vbCrLf
    s = s & "            Else" & vbCrLf
    s = s & "                Exit Do" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        Loop" & vbCrLf
    s = s & "        If Len(tok) > 0 Then" & vbCrLf
    s = s & "            conv = ConvertToken(tok, toLatin)" & vbCrLf
    s = s & "            If conv <> tok Then" & vbCrLf
    s = s & "                w.SetRange w.Start, w.Start + Len(tok)" & vbCrLf
    s = s & "                If w.Text = tok Then w.Text = conv" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub ConvertRange(ByVal scope As Range, ByVal toLatin As Boolean)" & vbCrLf
    s = s & "    Dim para As Paragraph, pr As Range, a As Long, b As Long" & vbCrLf
    s = s & "    For Each para In scope.Paragraphs" & vbCrLf
    s = s & "        a = para.Range.Start" & vbCrLf
    s = s & "        If scope.Start > a Then a = scope.Start" & vbCrLf
    s = s & "        b = para.Range.End" & vbCrLf
    s = s & "        If scope.End < b Then b = scope.End" & vbCrLf
    s = s & "        If b > a Then" & vbCrLf
    s = s & "            Set pr = scope.Duplicate" & vbCrLf
    s = s & "            pr.SetRange a, b" & vbCrLf
    s = s & "            ConvertPiece pr, toLatin" & vbCrLf
    ModPart6 = s
End Function

