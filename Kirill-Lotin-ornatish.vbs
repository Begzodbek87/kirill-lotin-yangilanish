    s = s & "' Rasmiy asos: OAK dissertatsiya qoidalari 13-14-bandlar: ro'yxat uch qismdan iborat," & vbCrLf
    s = s & "' alifbo / sistematik / havola ketma-ketligida, havola qilinmagan manba kiritilmaydi." & vbCrLf
    s = s & "Private Function BibNorm(ByVal s As String) As String" & vbCrLf
    s = s & "    s = LCase$(Trim$(s))" & vbCrLf
    s = s & "    s = Replace(s, ChrW(&H2BB), """")" & vbCrLf
    s = s & "    s = Replace(s, ChrW(&H2BC), """")" & vbCrLf
    s = s & "    s = Replace(s, ChrW(&H2018), """")" & vbCrLf
    s = s & "    s = Replace(s, ChrW(&H2019), """")" & vbCrLf
    s = s & "    s = Replace(s, ""'"", """")" & vbCrLf
    s = s & "    s = Replace(s, ""`"", """")" & vbCrLf
    s = s & "    Do While Len(s) > 0 And (Right$(s, 1) = ""."" Or Right$(s, 1) = "":"" Or Right$(s, 1) = "" "")" & vbCrLf
    s = s & "        s = Left$(s, Len(s) - 1)" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    Do While Len(s) > 0 And (Left$(s, 1) Like ""[0-9. ]"")" & vbCrLf
    s = s & "        s = Mid$(s, 2)" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    BibNorm = s" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function BibIsHead(ByVal t As String) As Boolean" & vbCrLf
    s = s & "    Dim s As String" & vbCrLf
    s = s & "    BibIsHead = False" & vbCrLf
    s = s & "    t = Replace(Replace(t, vbCr, """"), Chr$(7), """")" & vbCrLf
    s = s & "    If Len(t) > 70 Or Len(t) < 5 Then Exit Function" & vbCrLf
    s = s & "    s = BibNorm(CyrToLat(t))" & vbCrLf
    s = s & "    Select Case s" & vbCrLf
    s = s & "        Case ""foydalanilgan adabiyotlar"", ""foydalanilgan adabiyotlar royxati"", ""adabiyotlar royxati"", ""adabiyotlar"", _" & vbCrLf
    s = s & "             ""foydalanilgan adabiyotlar va manbalar"", ""foydalanilgan manbalar"", ""references"", ""bibliography"", _" & vbCrLf
    s = s & "             ""list of references"", ""literature""" & vbCrLf
    s = s & "            BibIsHead = True" & vbCrLf
    s = s & "    End Select" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function BibFindList(ByRef lStart As Long, ByRef lEnd As Long) As Boolean" & vbCrLf
    s = s & "    Dim para As Paragraph, hdrEnd As Long, rr As Range, t As String, s As String" & vbCrLf
    s = s & "    BibFindList = False" & vbCrLf
    s = s & "    If Selection.Start <> Selection.End Then" & vbCrLf
    s = s & "        lStart = Selection.Paragraphs(1).Range.Start" & vbCrLf
    s = s & "        lEnd = Selection.Paragraphs(Selection.Paragraphs.Count).Range.End" & vbCrLf
    s = s & "        BibFindList = (lEnd > lStart)" & vbCrLf
    s = s & "        Exit Function" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    hdrEnd = -1" & vbCrLf
    s = s & "    For Each para In ActiveDocument.Paragraphs" & vbCrLf
    s = s & "        t = para.Range.Text" & vbCrLf
    s = s & "        If Len(t) < 80 Then" & vbCrLf
    s = s & "            If BibIsHead(t) Then hdrEnd = para.Range.End" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next para" & vbCrLf
    s = s & "    If hdrEnd < 0 Then Exit Function" & vbCrLf
    s = s & "    Set rr = ActiveDocument.Range(hdrEnd, ActiveDocument.Content.End)" & vbCrLf
    s = s & "    lStart = hdrEnd" & vbCrLf
    s = s & "    lEnd = hdrEnd" & vbCrLf
    s = s & "    For Each para In rr.Paragraphs" & vbCrLf
    s = s & "        t = para.Range.Text" & vbCrLf
    s = s & "        If Len(Trim$(Replace(Replace(t, vbCr, """"), Chr$(7), """"))) > 0 Then" & vbCrLf
    s = s & "            If para.OutlineLevel <= 3 Then Exit For" & vbCrLf
    s = s & "            s = BibNorm(CyrToLat(Left$(t, 40)))" & vbCrLf
    s = s & "            If Left$(s, 5) = ""ilova"" Then Exit For" & vbCrLf
    s = s & "            lEnd = para.Range.End" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next para" & vbCrLf
    s = s & "    BibFindList = (lEnd > lStart)" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function BibClean(ByVal t As String) As String" & vbCrLf
    ModPart31 = s
End Function

