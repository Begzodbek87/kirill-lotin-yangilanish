    s = s & "        r = r & ""|"" & st & sufs(i)" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    If lastc = ""q"" Then" & vbCrLf
    s = s & "        r = r & ""|"" & st & ""qa""" & vbCrLf
