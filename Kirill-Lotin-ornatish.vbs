Function FixAcl()
    ' Word avtozamena fayllari (MSO*.acl) haddan tashqari kattalashgan bo'lsa, zaxiraga olinadi
    Dim dirA, fl, n, bak
    n = 0
    dirA = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Office"
    On Error Resume Next
    If fso.FolderExists(dirA) Then
        For Each fl In fso.GetFolder(dirA).Files
            If LCase(fso.GetExtensionName(fl.Name)) = "acl" And fl.Size > 1000000 Then
                bak = fl.Path & ".kl-zaxira"
                If fso.FileExists(bak) Then fso.DeleteFile bak, True
                fl.Move bak
                If Err.Number = 0 Then n = n + 1
                Err.Clear
            End If
        Next
    End If
    On Error GoTo 0
    FixAcl = n
End Function

Function ActB36(n, ln)
    Dim s, i, d
    s = ""
    n = CDbl(n)
    For i = 1 To ln
        d = n - Int(n / 36) * 36
        s = Mid("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ", CLng(d) + 1, 1) & s
        n = Int(n / 36)
    Next
    ActB36 = s
End Function

Function ActHash(s, mult, p)
    Dim h, i
    h = CDbl(7)
    For i = 1 To Len(s)
        h = h * CDbl(mult) + AscW(Mid(s, i, 1))
        h = h - Int(h / CDbl(p)) * CDbl(p)
    Next
    ActHash = h
End Function

Function MachineCode()
    Dim n, drv
    drv = sh.ExpandEnvironmentStrings("%SystemDrive%")
    If drv = "" Or drv = "%SystemDrive%" Then drv = "C:"
    n = CDbl(0)
    On Error Resume Next
    n = CDbl(fso.GetDrive(drv).SerialNumber)
    On Error GoTo 0
    If n < 0 Then n = n + CDbl(4294967296)
    MachineCode = "KL-" & ActB36(n, 7)
End Function

Function ActCode(m)
    ActCode = ActB36(ActHash(m & "E3KPA2YMNO76NE789LWS", 131, CDbl(2147483629)), 6) & "-" & _
              ActB36(ActHash("E3KPA2YMNO76NE789LWS" & m & "Q", 137, CDbl(2147483587)), 6)
End Function

Function NormCode(s)
    NormCode = UCase(Replace(Replace(Trim(s & ""), " ", ""), "-", ""))
End Function

