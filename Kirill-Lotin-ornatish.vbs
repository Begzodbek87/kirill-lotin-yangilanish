    s = s & "                    Next i" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "                cnt = cnt + 1" & vbCrLf
    s = s & "                If cnt Mod 50 = 0 Then" & vbCrLf
    s = s & "                    Application.StatusBar = ""Avtozamena ("" & label & "", "" & (pass + 1) & ""/4): "" & cnt & "" so'z...""" & vbCrLf
    s = s & "                    DoEvents" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        Loop" & vbCrLf
    s = s & "        f.Close" & vbCrLf
    s = s & "NextPass:" & vbCrLf
    s = s & "    Next pass" & vbCrLf
    s = s & "    d.Close 0" & vbCrLf
    s = s & "    Application.ScreenUpdating = True" & vbCrLf
    s = s & "    Application.StatusBar = False" & vbCrLf
    s = s & "    HxAcRun = total" & vbCrLf
