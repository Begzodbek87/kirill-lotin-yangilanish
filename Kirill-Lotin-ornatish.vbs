End If
Err.Clear
On Error GoTo 0
If ver = "" Or Not IsNumeric(Replace(ver, ".0", "")) Then ver = "16.0"
If ver = "15.0" Or ver = "14.0" Or ver = "12.0" Or ver = "16.0" Then
Else
    ver = "16.0"
End If

regPath = "HKCU\Software\Microsoft\Office\" & ver & "\Word\Security\AccessVBOM"
On Error Resume Next
oldVal = sh.RegRead(regPath)
If Err.Number = 0 Then hadVal = True
Err.Clear
sh.RegWrite regPath, 1, "REG_DWORD"
If Err.Number = 0 Then wrote = True
Err.Clear
On Error GoTo 0

' ---- 4. Modul faylini vaqtincha yozish ----
Set f = fso.CreateTextFile(tmpFile, True, False)
f.Write ModuleText()
f.Close

' ---- 5. Word orqali shablon yaratish ----
On Error Resume Next
Set wd = CreateObject("Word.Application")
If Err.Number <> 0 Then
    Set wd = Nothing
    On Error GoTo 0
    Finish "Microsoft Word topilmadi. Word o'rnatilgan kompyuterda qayta urinib ko'ring.", 16
End If
wd.Visible = False
wd.DisplayAlerts = 0
wd.AutomationSecurity = 3
Err.Clear

Set doc = wd.Documents.Add
If Err.Number <> 0 Then
    errMsg = Err.Description
    On Error GoTo 0
    Finish "Word hujjat yarata olmadi: " & errMsg, 16
End If

doc.VBProject.VBComponents.Import tmpFile
If Err.Number <> 0 Then
    errMsg = Err.Description
    On Error GoTo 0
    Finish "Word VBA loyihasiga kirishga ruxsat bermadi (xavfsizlik siyosati). " & _
           "Word: Fayl > Parametrlar > Ishonch markazi > Makro sozlamalari > " & _
           """VBA loyiha obyekt modeliga ishonch"" ni yoqing va qayta urinib ko'ring. (" & errMsg & ")", 16
End If

startup = ""
startup = wd.Options.DefaultFilePath(8)
If Err.Number <> 0 Or startup = "" Then
    startup = defStartup
    Err.Clear
End If
If Not fso.FolderExists(startup) Then fso.CreateFolder startup
target = startup & "\KirillLotin.dotm"
If fso.FileExists(target) Then fso.DeleteFile target, True

Err.Clear
doc.SaveAs target, 15
If Err.Number <> 0 Then
    errMsg = Err.Description
    On Error GoTo 0
    Finish "Shablonni saqlab bo'lmadi: " & errMsg, 16
End If
On Error GoTo 0

If fso.FileExists(target) Then
    ' ---- 6. Lenta (Ribbon): "Kirill-Lotin" yorlig'i ikonkalar bilan ----
    On Error Resume Next
    doc.Close 0
    Set doc = Nothing
    wd.Quit 0
    Set wd = Nothing
    Err.Clear
    On Error GoTo 0
    WScript.Sleep 1500
    ribVer = ver
    ribOk = AddRibbon(target, root, ribVer)
    On Error Resume Next
    If ribOk Then
        sh.RegWrite "HKCU\Software\VB and VBA Program Settings\KirillLotin\Opts\Ribbon", "1", "REG_SZ"
        ribNote = "Wordni oching: yuqoridagi lentada 'Kirill-Lotin' yorlig'i (ikonkalar bilan) paydo bo'ladi:" & vbCrLf & _
                  "  Yozuv  |  Imlo  |  Tahlil  |  Hujjat (Adabiyotlar, Manba yozish)  |  Lug'at  |  Dastur"
    Else
        sh.RegWrite "HKCU\Software\VB and VBA Program Settings\KirillLotin\Opts\Ribbon", "0", "REG_SZ"
        ribNote = "Lenta yorlig'ini joylab bo'lmadi, shuning uchun eski panel ishlatiladi: 'Add-Ins' (Nadstroyki) yorlig'ida." & vbCrLf & _
                  "(Sabab fayli: " & root & "\ribbon\ribbon-xato.txt)"
    End If
    Err.Clear
    On Error GoTo 0
    On Error Resume Next
    WriteFile root & "\version.txt", KL_VERSION & vbCrLf
    updNote = ""
    If Len(UPDATE_URL) > 0 Then
        If Not silent Then sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\KirillLotinUpdate", "wscript.exe //B //Nologo """ & root & "\updater.vbs"" /auto", "REG_SZ"
        updNote = "Yangi versiyalar kompyuter yoqilganda o'zi tekshiriladi (qo'lda: lenta > Dastur > Yangilash)." & vbCrLf
    End If
    Err.Clear
    On Error GoTo 0
    Finish "O'rnatildi!" & vbCrLf & vbCrLf & _
           ribNote & vbCrLf & _
           "Imlo tekshirgandan so'ng takliflar menyusida so'zni bosib almashtirasiz ('Keyingi taklif' tugmasi yoki o'ng tugma)." & vbCrLf & _
           "Yozish paytida tuzatish uchun: Imlo > Avtozamena > Yoqish." & vbCrLf & _
           "Ish stolida 'PDF - Word (OCR)', 'Antiplagiat', 'Korpus tahlili' va 'Atamalar lug'ati' yorliqlari bor." & vbCrLf & _
           updNote & _
           "Antiplagiat: Vikipediya rejimi kalitsiz ishlaydi; Brave/Serper uchun API kaliti kerak." & vbCrLf & vbCrLf & _
           "Agar Word makroslarni bloklasa, sariq panelda 'Enable content' tugmasini bosing." & ocrNote & aclNote, 64
Else
    Finish "O'rnatish tugallanmadi: fayl yaratilmadi.", 16
End If
