    s = s & "    End If" & vbCrLf
    s = s & "    r.SetTimeouts 10000, 10000, 20000, 180000" & vbCrLf
    s = s & "    r.Open ""GET"", u, False" & vbCrLf
    s = s & "    r.SetOption 9, 2720" & vbCrLf
