    s = s & "Yangi yil munosabati bilan katta chegirmalar! Faqat shu hafta barcha mahsulotlarga yigirma foiz chegirma. Shoshiling, takliflar soni cheklangan!" & vbCrLf
    s = s & "Sifatli, arzon va ishonchli " & ChrW(8212) & " bu bizning shiorimiz. Bizning do" & ChrW(699) & "konda eng yaxshi mahsulotlar eng qulay narxlarda. Bepul yetkazib berish va kafolat bilan!" & vbCrLf
