    s = s & "        Case ""uzc"": SnWord = SnCyr(""1052,1091,1088,1086,1078,1072,1072,1090,32,1089,1072,1085,1072,1089,1080"")" & vbCrLf
    s = s & "        Case ""en"": SnWord = ""Date accessed""" & vbCrLf
