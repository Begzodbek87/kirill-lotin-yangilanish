Option Explicit
' --- Yangilanish sozlamalari (muallif to'ldiradi) ---
' UPDATE_URL: yangilanish fayllari turgan manzil, masalan
' "https://raw.githubusercontent.com/FOYDALANUVCHI/OMBOR/main/"
Const KL_VERSION = "2026.10.09.7"
Const UPDATE_URL = "https://raw.githubusercontent.com/Begzodbek87/kirill-lotin-yangilanish/main/"
Dim silent, updNote
Dim sh, fso, wd, doc, tmpFile, startup, defStartup, target, ver, v, parts, f
Dim regPath, oldVal, hadVal, wrote, errMsg, root, rc, lnk, ocrOk, ocrNote
Dim mcode, acode, savedAct, entered, aclN, aclNote, ribOk, ribNote, ribVer

Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
Set wd = Nothing
Set doc = Nothing
hadVal = False
wrote = False
regPath = ""
tmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\KirillLotin_tmp.bas"
silent = False
If WScript.Arguments.Count > 0 Then
    If LCase(WScript.Arguments(0)) = "/update" Then silent = True
End If

Sub Finish(msg, code)
    On Error Resume Next
    If Not doc Is Nothing Then doc.Close 0
    If Not wd Is Nothing Then wd.Quit 0
    If wrote Then
        If hadVal Then
            sh.RegWrite regPath, oldVal, "REG_DWORD"
        Else
            sh.RegDelete regPath
        End If
    End If
    If fso.FileExists(tmpFile) Then fso.DeleteFile tmpFile, True
    On Error GoTo 0
    If silent Then
        LogSilent msg
    Else
        MsgBox msg, code, "Olim yordamchisi"
    End If
    WScript.Quit
End Sub

Sub LogSilent(msg)
    Dim lf
    On Error Resume Next
    Set lf = fso.OpenTextFile(sh.ExpandEnvironmentStrings("%PUBLIC%") & "\KirillLotinOCR\update.log", 8, True)
    lf.WriteLine Now & "  [o'rnatuvchi] " & Replace(msg, vbCrLf, " ")
    lf.Close
End Sub

Function AskBox(msg, code, title)
    If silent Then
        AskBox = 7
    Else
        AskBox = MsgBox(msg, code, title)
    End If
End Function

