    s = s & "        c = CodeAt(tok, i)" & vbCrLf
    s = s & "        If isCyr Then" & vbCrLf
    s = s & "            If c = &H445 Or c = &H425 Or c = &H4B3 Or c = &H4B2 Then" & vbCrLf
    s = s & "                up = (c = &H425 Or c = &H4B2)" & vbCrLf
    s = s & "                If Mid$(pat, k, 1) = ""h"" Then" & vbCrLf
    s = s & "                    If up Then w = ChrW(&H4B2) Else w = ChrW(&H4B3)" & vbCrLf
    s = s & "                Else" & vbCrLf
    s = s & "                    If up Then w = ChrW(&H425) Else w = ChrW(&H445)" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "                Mid$(r, i, 1) = w" & vbCrLf
    s = s & "                k = k + 1" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        Else" & vbCrLf
    s = s & "            ch = LCase$(Mid$(tok, i, 1))" & vbCrLf
    s = s & "            nx = LCase$(Mid$(tok, i + 1, 1))" & vbCrLf
    s = s & "            If (ch = ""s"" Or ch = ""c"") And nx = ""h"" Then" & vbCrLf
    s = s & "                i = i + 1" & vbCrLf
    s = s & "            ElseIf ch = ""h"" Or ch = ""x"" Then" & vbCrLf
    s = s & "                w = Mid$(pat, k, 1)" & vbCrLf
    s = s & "                If Mid$(tok, i, 1) <> ch Then w = UCase$(w)" & vbCrLf
    s = s & "                Mid$(r, i, 1) = w" & vbCrLf
    s = s & "                k = k + 1" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "        i = i + 1" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    HxApply = r" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function HxLoad() As Boolean" & vbCrLf
    s = s & "    Dim p As String, fso As Object, f As Object, ln As String, parts() As String, k As String" & vbCrLf
    s = s & "    If Not gHX Is Nothing Then" & vbCrLf
    s = s & "        HxLoad = True" & vbCrLf
    s = s & "        Exit Function" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    p = Environ$(""PUBLIC"") & ""\KirillLotinOCR\hxbase.txt""" & vbCrLf
    s = s & "    Set fso = CreateObject(""Scripting.FileSystemObject"")" & vbCrLf
    s = s & "    If Not fso.FileExists(p) Then Exit Function" & vbCrLf
    s = s & "    Set gHX = CreateObject(""Scripting.Dictionary"")" & vbCrLf
    s = s & "    gHX.CompareMode = 0" & vbCrLf
    s = s & "    Set f = fso.OpenTextFile(p, 1, False, 0)" & vbCrLf
    s = s & "    Do While Not f.AtEndOfStream" & vbCrLf
    s = s & "        ln = Trim$(f.ReadLine)" & vbCrLf
    s = s & "        If Len(ln) > 0 And Left$(ln, 1) <> "";"" Then" & vbCrLf
    s = s & "            parts = Split(ln, ""|"")" & vbCrLf
    s = s & "            k = HxKey(Replace(parts(0), ""!"", """"))" & vbCrLf
    s = s & "            If gHX.Exists(k) Then" & vbCrLf
    s = s & "                gHX(k) = gHX(k) & ""|"" & ln" & vbCrLf
    s = s & "            Else" & vbCrLf
    ModPart12 = s
End Function

Function ModPart13()
    Dim s
    s = ""
    s = s & "                gHX.Add k, ln" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    f.Close" & vbCrLf
    s = s & "    HxLoad = True" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "' 0 = to'g'ri yoki bazada yo'q, 1 = aniq xato (newTok), 2/3 = chalkash (note)" & vbCrLf
    s = s & "Private Function HxCheck(ByVal tok As String, ByRef newTok As String, ByRef note As String) As Long" & vbCrLf
    s = s & "    Dim nC As Long, nL As Long, i As Long, c As Long, isCyr As Boolean" & vbCrLf
    s = s & "    Dim lat As String, kw As String, L As Long, pre As String, n As Long, cur As String" & vbCrLf
    s = s & "    Dim forms() As String, pat As String, pList As String, cnt As Long" & vbCrLf
    s = s & "    Dim okHit As Boolean, rareHit As Boolean, f As String, shown As String, pp() As String" & vbCrLf
    s = s & "    HxCheck = 0" & vbCrLf
    s = s & "    gHxSug = """"" & vbCrLf
    s = s & "    For i = 1 To Len(tok)" & vbCrLf
    s = s & "        c = CodeAt(tok, i)" & vbCrLf
    s = s & "        If c >= &H400 And c <= &H4FF Then nC = nC + 1" & vbCrLf
    s = s & "        If (c >= 65 And c <= 90) Or (c >= 97 And c <= 122) Then nL = nL + 1" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    If nC > 0 And nL > 0 Then Exit Function" & vbCrLf
    s = s & "    isCyr = (nC > 0)" & vbCrLf
    s = s & "    If isCyr Then" & vbCrLf
    s = s & "        If Len(HxCurPattern(tok, True)) = 0 Then Exit Function" & vbCrLf
    s = s & "        lat = CyrToLat(tok)" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        lat = tok" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    kw = HxKey(lat)" & vbCrLf
    s = s & "    If InStr(kw, ""#"") = 0 Then Exit Function" & vbCrLf
    s = s & "    If gHX.Exists(kw) Then" & vbCrLf
    s = s & "        L = Len(kw)" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        If Len(kw) < 5 Then Exit Function" & vbCrLf
    s = s & "        For L = Len(kw) - 1 To 4 Step -1" & vbCrLf
    s = s & "            If gHX.Exists(Left$(kw, L)) Then Exit For" & vbCrLf
    s = s & "        Next L" & vbCrLf
    s = s & "        If L < 4 Then Exit Function" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    pre = Left$(kw, L)" & vbCrLf
    s = s & "    If InStr(pre, ""#"") = 0 Then Exit Function" & vbCrLf
    s = s & "    n = Len(pre) - Len(Replace(pre, ""#"", """"))" & vbCrLf
    s = s & "    cur = Left$(HxCurPattern(tok, isCyr), n)" & vbCrLf
    s = s & "    forms = Split(gHX(pre), ""|"")" & vbCrLf
    s = s & "    For i = 0 To UBound(forms)" & vbCrLf
    s = s & "        f = Replace(forms(i), ""!"", """")" & vbCrLf
    s = s & "        pat = HxPattern(f)" & vbCrLf
    s = s & "        If InStr(""|"" & pList & ""|"", ""|"" & pat & ""|"") = 0 Then" & vbCrLf
    s = s & "            If cnt > 0 Then pList = pList & ""|""" & vbCrLf
    s = s & "            pList = pList & pat" & vbCrLf
    s = s & "            cnt = cnt + 1" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "        If pat = cur Then" & vbCrLf
    s = s & "            If Left$(forms(i), 1) = ""!"" Then rareHit = True Else okHit = True" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "        If isCyr Then f = LatToCyr(f)" & vbCrLf
    s = s & "        If InStr("" / "" & shown & "" / "", "" / "" & f & "" / "") = 0 Then" & vbCrLf
    s = s & "            If Len(shown) > 0 Then shown = shown & "" / """ & vbCrLf
    s = s & "            shown = shown & f" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    If cnt = 1 Then" & vbCrLf
    s = s & "        If cur = pList Then Exit Function" & vbCrLf
    s = s & "        newTok = HxApply(tok, isCyr, pList)" & vbCrLf
    s = s & "        If newTok <> tok Then HxCheck = 1" & vbCrLf
    s = s & "        Exit Function" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    If okHit Then Exit Function" & vbCrLf
    s = s & "    note = shown" & vbCrLf
    s = s & "    pp = Split(pList, ""|"")" & vbCrLf
    s = s & "    For i = 0 To UBound(pp)" & vbCrLf
    s = s & "        f = HxApply(tok, isCyr, pp(i))" & vbCrLf
    s = s & "        If f <> tok Then" & vbCrLf
    s = s & "            If Len(gHxSug) > 0 Then gHxSug = gHxSug & "" / """ & vbCrLf
    s = s & "            gHxSug = gHxSug & f" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    If rareHit Then HxCheck = 2 Else HxCheck = 3" & vbCrLf
    s = s & "End Function" & vbCrLf
    ModPart13 = s
End Function

Function ModPart14()
    Dim s
    s = ""
    s = s & "" & vbCrLf
    s = s & "Private Sub HxComment(ByVal r As Range, ByVal t As String)" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    ActiveDocument.Comments.Add r, t" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub HxPiece(ByVal pr As Range)" & vbCrLf
    s = s & "    Dim txt As String, basePos As Long, n As Long, i As Long, j As Long, k As Long, q As Long" & vbCrLf
    s = s & "    Dim s As Long, e As Long, cnt As Long, res As Long" & vbCrLf
    s = s & "    Dim tok As String, newTok As String, note As String" & vbCrLf
    s = s & "    Dim tr As Range, cr As Range" & vbCrLf
    s = s & "    Dim tS() As Long, tE() As Long" & vbCrLf
    s = s & "    If pr.Fields.Count > 0 Then Exit Sub" & vbCrLf
    s = s & "    txt = pr.Text" & vbCrLf
    s = s & "    basePos = pr.Start" & vbCrLf
    s = s & "    n = Len(txt)" & vbCrLf
    s = s & "    If n = 0 Then Exit Sub" & vbCrLf
    s = s & "    ReDim tS(1 To n)" & vbCrLf
    s = s & "    ReDim tE(1 To n)" & vbCrLf
    s = s & "    cnt = 0" & vbCrLf
    s = s & "    i = 1" & vbCrLf
    s = s & "    Do While i <= n" & vbCrLf
    s = s & "        If IsTokChar(CodeAt(txt, i)) Then" & vbCrLf
    s = s & "            j = i" & vbCrLf
    s = s & "            Do While j < n" & vbCrLf
    s = s & "                If IsTokChar(CodeAt(txt, j + 1)) Then" & vbCrLf
    s = s & "                    j = j + 1" & vbCrLf
    s = s & "                Else" & vbCrLf
    s = s & "                    Exit Do" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            Loop" & vbCrLf
    s = s & "            s = i" & vbCrLf
    s = s & "            e = j" & vbCrLf
    s = s & "            Do While s <= e" & vbCrLf
    s = s & "                If IsLetterCode(CodeAt(txt, s)) Then Exit Do" & vbCrLf
    s = s & "                s = s + 1" & vbCrLf
    s = s & "            Loop" & vbCrLf
    s = s & "            Do While e >= s" & vbCrLf
    s = s & "                If IsLetterCode(CodeAt(txt, e)) Then Exit Do" & vbCrLf
    s = s & "                e = e - 1" & vbCrLf
    s = s & "            Loop" & vbCrLf
    s = s & "            If e >= s Then" & vbCrLf
    s = s & "                cnt = cnt + 1" & vbCrLf
    s = s & "                tS(cnt) = s" & vbCrLf
    s = s & "                tE(cnt) = e" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "            i = j + 1" & vbCrLf
    s = s & "        Else" & vbCrLf
    s = s & "            i = i + 1" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    For k = cnt To 1 Step -1" & vbCrLf
    s = s & "        tok = Mid$(txt, tS(k), tE(k) - tS(k) + 1)" & vbCrLf
    s = s & "        newTok = """"" & vbCrLf
    s = s & "        note = """"" & vbCrLf
    s = s & "        res = HxCheck(tok, newTok, note)" & vbCrLf
    s = s & "        If res > 0 Then" & vbCrLf
    s = s & "            Set tr = pr.Duplicate" & vbCrLf
    s = s & "            tr.SetRange basePos + tS(k) - 1, basePos + tE(k)" & vbCrLf
    s = s & "            If tr.Text = tok Then" & vbCrLf
    s = s & "                If res = 1 And gHxMode = 1 Then" & vbCrLf
    s = s & "                    For q = 1 To Len(tok)" & vbCrLf
    s = s & "                        If Mid$(tok, q, 1) <> Mid$(newTok, q, 1) Then" & vbCrLf
    s = s & "                            Set cr = pr.Duplicate" & vbCrLf
    s = s & "                            cr.SetRange basePos + tS(k) - 1 + q - 1, basePos + tS(k) - 1 + q" & vbCrLf
    s = s & "                            cr.Text = Mid$(newTok, q, 1)" & vbCrLf
    s = s & "                        End If" & vbCrLf
    s = s & "                    Next q" & vbCrLf
    s = s & "                    tr.SetRange basePos + tS(k) - 1, basePos + tE(k)" & vbCrLf
    s = s & "                    tr.HighlightColorIndex = 4" & vbCrLf
    s = s & "                    gHxFix = gHxFix + 1" & vbCrLf
    s = s & "                ElseIf res = 1 Then" & vbCrLf
    s = s & "                    tr.HighlightColorIndex = 5" & vbCrLf
    s = s & "                    ImMark tr, ""fix"", ""h/x"", newTok" & vbCrLf
    s = s & "                    gHxMark = gHxMark + 1" & vbCrLf
    s = s & "                Else" & vbCrLf
    s = s & "                    tr.HighlightColorIndex = 7" & vbCrLf
    s = s & "                    If Len(gHxSug) > 0 Then" & vbCrLf
    s = s & "                        ImMark tr, ""flag"", ""h/x"", gHxSug" & vbCrLf
    ModPart14 = s
End Function

Function ModPart15()
    Dim s
