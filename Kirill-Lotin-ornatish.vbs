    s = s & "    st.Close" & vbCrLf
    s = s & "    If Err.Number = 0 Then SaveBinary = True" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "    On Error GoTo 0" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Function FileHash(path)" & vbCrLf
    s = s & "    Dim outF, f, ln, h, i" & vbCrLf
    s = s & "    h = """"" & vbCrLf
    s = s & "    outF = fso.GetSpecialFolder(2) & ""\kl_hash.txt""" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    If fso.FileExists(outF) Then fso.DeleteFile outF, True" & vbCrLf
    s = s & "    sh.Run ""cmd /c certutil -hashfile """""" & path & """""" SHA256 > """""" & outF & """""""", 0, True" & vbCrLf
    s = s & "    If fso.FileExists(outF) Then" & vbCrLf
    s = s & "        Set f = fso.OpenTextFile(outF, 1, False)" & vbCrLf
    s = s & "        i = 0" & vbCrLf
    s = s & "        Do While Not f.AtEndOfStream" & vbCrLf
    s = s & "            ln = f.ReadLine" & vbCrLf
    s = s & "            i = i + 1" & vbCrLf
    s = s & "            If i = 2 Then h = LCase(Replace(Trim(ln), "" "", """"))" & vbCrLf
    s = s & "        Loop" & vbCrLf
    s = s & "        f.Close" & vbCrLf
    s = s & "        fso.DeleteFile outF, True" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    On Error GoTo 0" & vbCrLf
    s = s & "    FileHash = h" & vbCrLf
    s = s & "End Function" & vbCrLf
    UpdPart2 = s
End Function

