Sub WaitWordGone()
    Dim w, n, t
    On Error Resume Next
    Set w = GetObject("winmgmts:\\.\root\cimv2")
    For t = 1 To 20
        n = 0
        n = w.ExecQuery("Select * from Win32_Process Where Name='WINWORD.EXE'").Count
        Err.Clear
        If n = 0 Then Exit For
        If t = 10 Then sh.Run "taskkill /f /im winword.exe", 0, True
        WScript.Sleep 1500
    Next
    Err.Clear
    On Error GoTo 0
End Sub

