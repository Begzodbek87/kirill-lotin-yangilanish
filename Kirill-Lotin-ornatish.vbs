    s = s & "        ImApplyCore CStr(v), w" & vbCrLf
    s = s & "    Next v" & vbCrLf
    s = s & "    EndUndo" & vbCrLf
    s = s & "    Application.ScreenUpdating = True" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "    ImNext False" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Public Sub ImSkip()" & vbCrLf
    s = s & "    ImNext False" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Public Sub ImKeep()" & vbCrLf
    s = s & "    Dim r As Range, ci As Long" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "    If ActiveDocument.Bookmarks.Exists(gCurBm) Then" & vbCrLf
    s = s & "        Set r = ActiveDocument.Bookmarks(gCurBm).Range" & vbCrLf
    s = s & "        ci = r.HighlightColorIndex" & vbCrLf
    s = s & "        If ci = 5 Or ci = 7 Then r.HighlightColorIndex = 0" & vbCrLf
    s = s & "        ActiveDocument.Bookmarks(gCurBm).Delete" & vbCrLf
    s = s & "        ActiveDocument.Variables(""kl"" & Mid$(gCurBm, 4)).Delete" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "    ImNext False" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub ImNext(ByVal manual As Boolean)" & vbCrLf
    s = s & "    Dim b As Bookmark, curS As Long, curE As Long, s As Long" & vbCrLf
    s = s & "    Dim bestNm As String, bestS As Long, firstNm As String, firstS As Long, anyLeft As Boolean" & vbCrLf
    s = s & "    If Documents.Count = 0 Then Exit Sub" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "    curS = Selection.Start" & vbCrLf
    s = s & "    curE = Selection.End" & vbCrLf
    s = s & "    bestS = -1" & vbCrLf
    s = s & "    firstS = -1" & vbCrLf
    s = s & "    For Each b In ActiveDocument.Bookmarks" & vbCrLf
    s = s & "        If ImMarkNum(b.Name) > 0 Then" & vbCrLf
    s = s & "            anyLeft = True" & vbCrLf
    s = s & "            s = b.Start" & vbCrLf
    s = s & "            If firstS < 0 Or s < firstS Then" & vbCrLf
    s = s & "                firstS = s" & vbCrLf
    s = s & "                firstNm = b.Name" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "            If (curE > curS And s > curS) Or (curE = curS And s >= curS) Then" & vbCrLf
    s = s & "                If bestS < 0 Or s < bestS Then" & vbCrLf
    s = s & "                    bestS = s" & vbCrLf
    s = s & "                    bestNm = b.Name" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next b" & vbCrLf
    s = s & "    If Len(bestNm) = 0 Then" & vbCrLf
    s = s & "        If manual And Len(firstNm) > 0 Then" & vbCrLf
    s = s & "            Application.StatusBar = ""Hujjat boshidan davom etildi.""" & vbCrLf
    s = s & "            bestNm = firstNm" & vbCrLf
    s = s & "        Else" & vbCrLf
    s = s & "            Application.StatusBar = False" & vbCrLf
    s = s & "            If anyLeft Then" & vbCrLf
    s = s & "                MsgBox ""Hujjat oxiriga yetildi. Ko'rib chiqilmagan takliflar qoldi."" & vbCrLf & _" & vbCrLf
    s = s & "                       ""Boshidan davom etish uchun 'Keyingi taklif' tugmasini bosing."", vbInformation, ""Imlo takliflari""" & vbCrLf
    s = s & "            Else" & vbCrLf
    s = s & "                MsgBox ""Barcha takliflar ko'rib chiqildi."", vbInformation, ""Imlo takliflari""" & vbCrLf
