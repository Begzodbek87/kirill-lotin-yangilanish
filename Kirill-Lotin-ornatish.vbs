    s = s & "    If fso.FileExists(outF) Then fso.DeleteFile outF, True" & vbCrLf
    s = s & "    If fso.FileExists(outF & "".err"") Then fso.DeleteFile outF & "".err"", True" & vbCrLf
    s = s & "    Set f = fso.CreateTextFile(inF, True, True)" & vbCrLf
    s = s & "    f.WriteLine ""OPTS"" & vbTab & mode & vbTab & digr & vbTab & CStr(Year(Date)) & vbTab & fmtOn" & vbCrLf
    s = s & "    For Each para In orig.Range(lS, lE).Paragraphs" & vbCrLf
    s = s & "        t = BibClean(para.Range.Text)" & vbCrLf
    s = s & "        If Len(Trim$(t)) > 0 Then f.WriteLine ""E"" & vbTab & t" & vbCrLf
    s = s & "    Next para" & vbCrLf
    s = s & "    nB = 0" & vbCrLf
    s = s & "    ReDim bS(0 To 0)" & vbCrLf
