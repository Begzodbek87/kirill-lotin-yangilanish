    s = s & "        End If" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        MsgBox msg, vbInformation, ""H/X tekshirish""" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    Exit Sub" & vbCrLf
    s = s & "Fail:" & vbCrLf
