    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' 1. Abzatslarni yig'ish" & vbCrLf
    s = s & "    pCnt = 0" & vbCrLf
    s = s & "    ReDim pA(0 To 0)" & vbCrLf
    s = s & "    ReDim pT(0 To 0)" & vbCrLf
    s = s & "    For Each para In scope.Paragraphs" & vbCrLf
