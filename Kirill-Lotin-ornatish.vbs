Function Nm5Part1()
    Dim s
    s = ""
    s = s & "Kech kuz edi. Qishloq ustida kulrang bulutlar suzib yurar, shamol so" & ChrW(699) & "nggi sarg" & ChrW(699) & "ish barglarni yerga to" & ChrW(699) & "kardi. Kampir hovlining to" & ChrW(699) & "rida, eski so" & ChrW(699) & "rida o" & ChrW(699) & "tirib, uzoq yo" & ChrW(699) & "lga tikilib qolgan edi." & vbCrLf
    s = s & "O" & ChrW(699) & "g" & ChrW(699) & "li shaharga ketganiga ancha bo" & ChrW(699) & "ldi. Har kuni ertalab u darvozaga chiqib, yo" & ChrW(699) & "lga qarar, keyin ohista uyga qaytardi. Yuragida umid so" & ChrW(699) & "nmagan, ammo ko" & ChrW(699) & "zlarida charchoq bor edi." & vbCrLf
    s = s & "Bir kuni kechqurun darvoza ochildi. Ostonada baland bo" & ChrW(699) & "yli, soqoli o" & ChrW(699) & "sgan yigit turardi. Kampir uni darrov tanimadi. Keyin yigit jilmaydi, va bu tabassum kampirning yuragini bir zumda isitib yubordi." & vbCrLf
    s = s & ChrW(8212) & " Onajon, " & ChrW(8212) & " dedi yigit sekin, " & ChrW(8212) & " men keldim." & vbCrLf
    s = s & "Kampir hech narsa demadi. U faqat o" & ChrW(699) & "g" & ChrW(699) & "lining yelkasiga boshini qo" & ChrW(699) & "ydi va uzoq yig" & ChrW(699) & "ladi. Hovlidagi qari tut daraxti esa shamolda sekin tebranib turardi." & vbCrLf
