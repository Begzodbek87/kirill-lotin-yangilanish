Function ModPart32()
    Dim s
    s = ""
    s = s & "                If Len(rec) > 0 And Left$(rec, 1) <> ""-"" Then" & vbCrLf
    s = s & "                    If Left$(rec, 1) = ""="" Then" & vbCrLf
    s = s & "                        parts = Split(Mid$(rec, 2), ""|"")" & vbCrLf
