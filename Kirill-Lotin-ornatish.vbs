Function RpsPart1()
    Dim s
    s = ""
    s = s & "# Kirill-Lotin: lenta (Ribbon) yorlig'ini .dotm shablonga joylaydi." & vbCrLf
    s = s & "# Ishlatish: powershell -File ribbon.ps1 -Dotm <shablon> -Dir <papka> -Ver 14" & vbCrLf
    s = s & "param([string]$Dotm, [string]$Dir, [int]$Ver = 14)" & vbCrLf
    s = s & "$ErrorActionPreference = 'Stop'" & vbCrLf
    s = s & "try {" & vbCrLf
    s = s & "    Add-Type -AssemblyName System.IO.Compression" & vbCrLf
    s = s & "    Add-Type -AssemblyName System.IO.Compression.FileSystem" & vbCrLf
    s = s & "    if ($Ver -eq 12) {" & vbCrLf
    s = s & "        $xmlName = 'customUI.xml'" & vbCrLf
    s = s & "        $relType = 'http://schemas.microsoft.com/office/2006/relationships/ui/extensibility'" & vbCrLf
    s = s & "    } else {" & vbCrLf
    s = s & "        $xmlName = 'customUI14.xml'" & vbCrLf
    s = s & "        $relType = 'http://schemas.microsoft.com/office/2007/relationships/ui/extensibility'" & vbCrLf
    s = s & "    }" & vbCrLf
    s = s & "    $imgType = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships/image'" & vbCrLf
    s = s & "    $utf8 = New-Object System.Text.UTF8Encoding($false)" & vbCrLf
    s = s & "    $xml = [System.IO.File]::ReadAllText((Join-Path $Dir $xmlName), $utf8)" & vbCrLf
    s = s & "    $icons = @()" & vbCrLf
    s = s & "    foreach ($ln in [System.IO.File]::ReadAllLines((Join-Path $Dir 'icons.txt'))) {" & vbCrLf
    s = s & "        $ix = $ln.IndexOf(':')" & vbCrLf
    s = s & "        if ($ix -gt 0) { $icons += ,@($ln.Substring(0, $ix), [Convert]::FromBase64String($ln.Substring($ix + 1))) }" & vbCrLf
    s = s & "    }" & vbCrLf
    s = s & "    $zip = $null" & vbCrLf
    s = s & "    for ($try = 0; $try -lt 15 -and $zip -eq $null; $try++) {" & vbCrLf
    s = s & "        try { $zip = [System.IO.Compression.ZipFile]::Open($Dotm, 'Update') } catch { Start-Sleep -Seconds 2 }" & vbCrLf
    s = s & "    }" & vbCrLf
    s = s & "    if ($zip -eq $null) { $zip = [System.IO.Compression.ZipFile]::Open($Dotm, 'Update') }" & vbCrLf
    s = s & "    try {" & vbCrLf
    s = s & "        # eski customUI qismlarini olib tashlash" & vbCrLf
    s = s & "        $old = @()" & vbCrLf
    s = s & "        foreach ($e in $zip.Entries) { if ($e.FullName -like 'customUI/*') { $old += $e } }" & vbCrLf
    s = s & "        foreach ($e in $old) { $e.Delete() }" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        function Put([object]$z, [string]$name, [byte[]]$bytes) {" & vbCrLf
    s = s & "            $en = $z.CreateEntry($name)" & vbCrLf
    s = s & "            $st = $en.Open()" & vbCrLf
    s = s & "            $st.Write($bytes, 0, $bytes.Length)" & vbCrLf
    s = s & "            $st.Close()" & vbCrLf
    s = s & "        }" & vbCrLf
    s = s & "        function GetText([object]$z, [string]$name) {" & vbCrLf
    s = s & "            $en = $z.GetEntry($name)" & vbCrLf
    s = s & "            if ($en -eq $null) { return $null }" & vbCrLf
    s = s & "            $rd = New-Object System.IO.StreamReader($en.Open(), (New-Object System.Text.UTF8Encoding($false)))" & vbCrLf
    s = s & "            $t = $rd.ReadToEnd()" & vbCrLf
    s = s & "            $rd.Close()" & vbCrLf
    s = s & "            $en.Delete()" & vbCrLf
    s = s & "            return $t" & vbCrLf
    s = s & "        }" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        Put $zip ('customUI/' + $xmlName) ($utf8.GetBytes($xml))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        $rels = New-Object System.Text.StringBuilder" & vbCrLf
    s = s & "        [void]$rels.Append('<?xml version=""1.0"" encoding=""UTF-8"" standalone=""yes""?>' + ""`r`n"")" & vbCrLf
    s = s & "        [void]$rels.Append('<Relationships xmlns=""http://schemas.openxmlformats.org/package/2006/relationships"">')" & vbCrLf
    s = s & "        foreach ($ic in $icons) {" & vbCrLf
    s = s & "            Put $zip ('customUI/images/' + $ic[0] + '.png') $ic[1]" & vbCrLf
    s = s & "            [void]$rels.Append('<Relationship Id=""' + $ic[0] + '"" Type=""' + $imgType + '"" Target=""images/' + $ic[0] + '.png""/>')" & vbCrLf
    s = s & "        }" & vbCrLf
    s = s & "        [void]$rels.Append('</Relationships>')" & vbCrLf
    s = s & "        Put $zip ('customUI/_rels/' + $xmlName + '.rels') ($utf8.GetBytes($rels.ToString()))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        # _rels/.rels" & vbCrLf
    s = s & "        $t = GetText $zip '_rels/.rels'" & vbCrLf
    s = s & "        if ($t -eq $null) { throw '_rels/.rels topilmadi' }" & vbCrLf
    s = s & "        $t = [regex]::Replace($t, '<Relationship [^>]*Target=""customUI/[^""]*""[^>]*/>', '')" & vbCrLf
    s = s & "        $t = $t.Replace('</Relationships>', '<Relationship Id=""rIdKLui1"" Type=""' + $relType + '"" Target=""customUI/' + $xmlName + '""/></Relationships>')" & vbCrLf
    s = s & "        Put $zip '_rels/.rels' ($utf8.GetBytes($t))" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "        # [Content_Types].xml" & vbCrLf
    s = s & "        $c = GetText $zip '[Content_Types].xml'" & vbCrLf
    s = s & "        if ($c -eq $null) { throw '[Content_Types].xml topilmadi' }" & vbCrLf
    s = s & "        if ($c -notmatch 'Extension=""png""') {" & vbCrLf
    s = s & "            $m = [regex]::Match($c, '<Types[^>]*>')" & vbCrLf
    s = s & "            $c = $c.Insert($m.Index + $m.Length, '<Default Extension=""png"" ContentType=""image/png""/>')" & vbCrLf
    s = s & "        }" & vbCrLf
    s = s & "        if ($c -notmatch 'Extension=""xml""') {" & vbCrLf
    s = s & "            $m = [regex]::Match($c, '<Types[^>]*>')" & vbCrLf
    s = s & "            $c = $c.Insert($m.Index + $m.Length, '<Default Extension=""xml"" ContentType=""application/xml""/>')" & vbCrLf
    s = s & "        }" & vbCrLf
    s = s & "        Put $zip '[Content_Types].xml' ($utf8.GetBytes($c))" & vbCrLf
    RpsPart1 = s
End Function

Function RpsPart2()
    Dim s
    s = ""
    s = s & "    } finally {" & vbCrLf
    s = s & "        $zip.Dispose()" & vbCrLf
    s = s & "    }" & vbCrLf
    s = s & "    # tekshirish" & vbCrLf
    s = s & "    $z2 = [System.IO.Compression.ZipFile]::OpenRead($Dotm)" & vbCrLf
    s = s & "    try {" & vbCrLf
    s = s & "        $ok = ($z2.GetEntry('customUI/' + $xmlName) -ne $null) -and ($z2.GetEntry('_rels/.rels') -ne $null) -and ($z2.GetEntry('[Content_Types].xml') -ne $null) -and ($z2.GetEntry('word/vbaProject.bin') -ne $null)" & vbCrLf
    s = s & "    } finally {" & vbCrLf
    s = s & "        $z2.Dispose()" & vbCrLf
    s = s & "    }" & vbCrLf
    s = s & "    if (-not $ok) { exit 3 }" & vbCrLf
    s = s & "    exit 0" & vbCrLf
    s = s & "} catch {" & vbCrLf
    s = s & "    try { [System.IO.File]::WriteAllText((Join-Path $Dir 'ribbon-xato.txt'), $_.Exception.Message) } catch {}" & vbCrLf
    s = s & "    exit 2" & vbCrLf
    s = s & "}" & vbCrLf
    RpsPart2 = s
End Function

Function RibbonPsText()
    RibbonPsText = RpsPart1() & RpsPart2()
End Function

Function BibPart1()
    Dim s
    s = ""
    s = s & "/* Adabiyotlar ro'yxatini OAK talablari bo'yicha tartiblash va tekshirish." & vbCrLf
    s = s & "   Rasmiy asos: O'zbekiston Respublikasi Vazirlar Mahkamasi huzuridagi OAK dissertatsiya" & vbCrLf
    s = s & "   qoidalari (13-band): ro'yxat uch qismdan iborat - (1) normativ-huquqiy hujjatlar va" & vbCrLf
    s = s & "   metodologik ahamiyatga molik nashrlar; (2) monografiya, ilmiy maqola, patent, to'plamlar;" & vbCrLf
    s = s & "   (3) boshqa adabiyotlar; tartib: alifbo, sistematik yoki matnda havola ketma-ketligi;" & vbCrLf
    s = s & "   matnda havola qilinmagan manba ro'yxatga kiritilmaydi." & vbCrLf
    s = s & "   Boshqa qoidalar (chet el va internet manbalarini alohida guruhlash, huquqiy kuch tartibi)" & vbCrLf
    s = s & "   odatdagi amaliyotga tayanadi va hisobotda shunday deb ko'rsatiladi." & vbCrLf
    s = s & "   Kirish (cscript): oak_biblio.js <kirish.txt> <chiqish.txt>   (ES3 / JScript mos) */" & vbCrLf
    s = s & "var BIB = (function () {" & vbCrLf
    s = s & "  var HEADS = {" & vbCrLf
    s = s & "    1: ""Normativ-huquqiy hujjatlar va metodologik ahamiyatga molik nashrlar""," & vbCrLf
    s = s & "    2: ""Monografiya, ilmiy maqola, to'plam va boshqa ilmiy-o'quv adabiyotlar""," & vbCrLf
    s = s & "    3: ""Rus tilidagi adabiyotlar""," & vbCrLf
    s = s & "    4: ""Ingliz va boshqa xorijiy tillardagi adabiyotlar""," & vbCrLf
    s = s & "    5: ""Internet saytlari va elektron resurslar""" & vbCrLf
    s = s & "  };" & vbCrLf
    s = s & "  var ROMAN = ['I', 'II', 'III', 'IV', 'V'];" & vbCrLf
    s = s & "  var LAT = 'abcdefghijklmnopqrstuvwxyz';" & vbCrLf
    s = s & "  var CYR = '\u0430\u0431\u0432\u0433\u0493\u0434\u0435\u0451\u0436\u0437\u0438\u0439\u043A\u049B\u043B\u043C\u043D\u043E\u043F\u0440\u0441\u0442\u0443\u045E\u0444\u0445\u04B3\u0446\u0447\u0448\u0449\u044A\u044B\u044C\u044D\u044E\u044F';" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  function trim(s) { return String(s).replace(/^[\s\u00A0]+|[\s\u00A0]+$/g, ''); }" & vbCrLf
    s = s & "  function normApos(s) { return String(s).replace(/[\u2018\u2019\u02BB\u02BC`\u00B4\u2032]/g, ""'""); }" & vbCrLf
    s = s & "  function lower(s) { return normApos(s).toLowerCase(); }" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "  /* ---- alifbo kaliti ---- */" & vbCrLf
    s = s & "  function akey(s, digr) {" & vbCrLf
    s = s & "    s = lower(s).replace(/^[^a-z0-9\u0400-\u04FF]+/, '');" & vbCrLf
    s = s & "    var out = '', i = 0, c, n, k;" & vbCrLf
    s = s & "    while (i < s.length) {" & vbCrLf
    s = s & "      c = s.charAt(i); n = s.charAt(i + 1);" & vbCrLf
    s = s & "      if (c >= '0' && c <= '9') { out += c; i++; continue; }" & vbCrLf
    s = s & "      if (digr && (c === 'o' || c === 'g') && n === ""'"") { out += String.fromCharCode(65 + (c === 'o' ? 40 : 41)); i += 2; continue; }" & vbCrLf
    s = s & "      if (digr && c === 's' && n === 'h') { out += String.fromCharCode(65 + 42); i += 2; continue; }" & vbCrLf
    s = s & "      if (digr && c === 'c' && n === 'h') { out += String.fromCharCode(65 + 43); i += 2; continue; }" & vbCrLf
    s = s & "      if (digr && c === 'n' && n === 'g') { out += String.fromCharCode(65 + 44); i += 2; continue; }" & vbCrLf
    s = s & "      k = LAT.indexOf(c);" & vbCrLf
    s = s & "      if (k >= 0) { out += String.fromCharCode(65 + k); i++; continue; }" & vbCrLf
    s = s & "      k = CYR.indexOf(c);" & vbCrLf
