    s = s & "        Exit Function" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    If okHit Then Exit Function" & vbCrLf
    s = s & "    note = shown" & vbCrLf
    s = s & "    pp = Split(pList, ""|"")" & vbCrLf
    s = s & "    For i = 0 To UBound(pp)" & vbCrLf
    s = s & "        f = HxApply(tok, isCyr, pp(i))" & vbCrLf
    s = s & "        If f <> tok Then" & vbCrLf
    s = s & "            If Len(gHxSug) > 0 Then gHxSug = gHxSug & "" / """ & vbCrLf
