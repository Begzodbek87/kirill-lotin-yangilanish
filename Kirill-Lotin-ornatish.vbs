    s = s & "    End If" & vbCrLf
    s = s & "    If InStr(w, ""'"") > 0 Then" & vbCrLf
    s = s & "        aps = Array(""'"", ChrW(&H2019), ChrW(&H2BB), ChrW(&H2018))" & vbCrLf
    s = s & "        For i = 0 To 3" & vbCrLf
    s = s & "            n = n + HxAcPut(Replace(w, ""'"", aps(i)), Replace(r, ""'"", aps(i)), mode)" & vbCrLf
    s = s & "        Next i" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        n = HxAcPut(w, r, mode)" & vbCrLf
    s = s & "    End If" & vbCrLf
    ModPart16 = s
End Function

