    s = s & "Korpus tadqiqotlarida chastota muhim o" & ChrW(699) & "rin tutadi. Chastota so" & ChrW(699) & "zning korpusda necha marta uchraganini ko" & ChrW(699) & "rsatadi. Biroq chastotaning o" & ChrW(699) & "zi yetarli emas: turli hajmdagi korpuslarni solishtirish uchun nisbiy chastota, ya" & ChrW(700) & "ni har million so" & ChrW(699) & "zga to" & ChrW(699) & "g" & ChrW(699) & "ri keladigan qo" & ChrW(699) & "llanishlar soni hisoblanadi." & vbCrLf
    s = s & "Konkordans so" & ChrW(699) & "zni uning chap va o" & ChrW(699) & "ng konteksti bilan birga ko" & ChrW(699) & "rsatadi. Konkordans qatorlarini o" & ChrW(699) & "qib, tadqiqotchi so" & ChrW(699) & "zning ma" & ChrW(700) & "no qirralarini va qo" & ChrW(699) & "llanish qoliplarini aniqlaydi. Kollokatsiya esa ikki so" & ChrW(699) & "zning tasodifiy ehtimoldan ko" & ChrW(699) & "ra ko" & ChrW(699) & "proq birga kelishidir. Masalan, til korpusi, ona tili, davlat tili kabi birikmalar o" & ChrW(699) & "zbek matnlarida tez-tez uchraydi." & vbCrLf
    s = s & "Korpus tuzishda matnlar vakillik va muvozanat tamoyillari asosida tanlanadi. Agar korpusda faqat badiiy matnlar bo" & ChrW(699) & "lsa, undan olingan xulosalar ilmiy yoki rasmiy uslubga taalluqli bo" & ChrW(699) & "lmaydi. Shuning uchun yaxshi korpus turli uslub, janr va davrga oid matnlarni o" & ChrW(699) & "z ichiga oladi." & vbCrLf
