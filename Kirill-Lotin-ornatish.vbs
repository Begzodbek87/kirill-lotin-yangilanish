    s = s & "" & vbCrLf
    s = s & "Private Function SnLang(ByVal ctx As String, ByVal t As String) As String" & vbCrLf
    s = s & "    Dim s As String, i As Long, c As Long, cyr As Long, lat As Long, mk As Long, en As Long, uz As Long, sl As String" & vbCrLf
    s = s & "    s = ctx" & vbCrLf
