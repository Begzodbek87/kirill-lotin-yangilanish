    s = s & "        ynd = MsgBox(""Har bir yozuvni ham OAK shakliga keltiraymi?"" & vbCrLf & vbCrLf & _" & vbCrLf
    s = s & "                     ""Ha - muallifdan sahifagacha: Familiya I.O. Nomi. "" & ChrW(8212) & "" Shahar: Nashriyot, Yil. "" & ChrW(8212) & "" N b."" & vbCrLf & _" & vbCrLf
    s = s & "                     ""       (ajratgich belgilar, qisqartmalar, bet ko'rsatkichi tuzatiladi;"" & vbCrLf & _" & vbCrLf
