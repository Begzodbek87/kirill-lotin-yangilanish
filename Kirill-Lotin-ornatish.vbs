    s = s & "    Set gIm = CreateObject(""Scripting.Dictionary"")" & vbCrLf
    s = s & "    gIm.CompareMode = 0" & vbCrLf
    s = s & "    Set f = fso.OpenTextFile(p, 1, False, 0)" & vbCrLf
