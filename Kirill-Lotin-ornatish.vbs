    s = s & "    Dim pos As Long, nm As String, wr As Range, c As String, k As Long, cyr As Boolean, ws As Long, we As Long" & vbCrLf
    s = s & "    If Not CheckAct() Then Exit Sub" & vbCrLf
    s = s & "    If Documents.Count = 0 Then Exit Sub" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    pos = Selection.Start" & vbCrLf
