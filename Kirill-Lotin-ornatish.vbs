    s = s & "" & vbCrLf
    s = s & "'------------------------------ Faollashtirish ----------------------------" & vbCrLf
    s = s & "Private Function ActB36(ByVal n As Double, ByVal ln As Long) As String" & vbCrLf
    s = s & "    Dim s As String, i As Long, d As Double" & vbCrLf
    s = s & "    For i = 1 To ln" & vbCrLf
    s = s & "        d = n - Int(n / 36) * 36" & vbCrLf
    s = s & "        s = Mid$(""0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"", CLng(d) + 1, 1) & s" & vbCrLf
    s = s & "        n = Int(n / 36)" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    ActB36 = s" & vbCrLf
    s = s & "End Function" & vbCrLf
