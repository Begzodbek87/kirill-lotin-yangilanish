    s = s & "            Set f = fso.OpenTextFile(outF & "".err"", 1, False, -1)" & vbCrLf
    s = s & "            If Not f.AtEndOfStream Then msg = f.ReadAll" & vbCrLf
    ModPart18 = s
End Function

