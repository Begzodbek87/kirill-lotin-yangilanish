Function ModPart20()
    Dim s
    s = ""
    s = s & "        Exit Sub" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    ' 3. Natijalarni qo'llash (fayldagi tartib: oxirgi abzatsdan boshiga, o'ngdan chapga)" & vbCrLf
    s = s & "    Application.ScreenUpdating = False" & vbCrLf
    s = s & "    BeginUndo" & vbCrLf
    s = s & "    ImClearMarks scope" & vbCrLf
    s = s & "    ImMarkInit" & vbCrLf
    s = s & "    Set f = fso.OpenTextFile(outF, 1, False, -1)" & vbCrLf
    s = s & "    Do While Not f.AtEndOfStream" & vbCrLf
    s = s & "        ln = f.ReadLine" & vbCrLf
    s = s & "        parts = Split(ln, vbTab)" & vbCrLf
    s = s & "        If UBound(parts) >= 6 Then" & vbCrLf
    s = s & "            idx = CLng(parts(0))" & vbCrLf
    s = s & "            s = CLng(parts(1))" & vbCrLf
    s = s & "            e = CLng(parts(2))" & vbCrLf
    s = s & "            If idx >= 0 And idx < pCnt Then" & vbCrLf
    s = s & "                Set r = scope.Duplicate" & vbCrLf
    s = s & "                r.SetRange pA(idx) + s, pA(idx) + e" & vbCrLf
    s = s & "                If r.Text = parts(6) Then" & vbCrLf
    s = s & "                    Select Case parts(3)" & vbCrLf
    s = s & "                        Case ""apos""" & vbCrLf
    s = s & "                            If mode = 1 Then" & vbCrLf
    s = s & "                                r.Text = parts(5)" & vbCrLf
    s = s & "                                nApos = nApos + 1" & vbCrLf
    s = s & "                            End If" & vbCrLf
    s = s & "                        Case ""fix""" & vbCrLf
    s = s & "                            If mode = 1 Then" & vbCrLf
    s = s & "                                r.Text = parts(5)" & vbCrLf
    s = s & "                                r.HighlightColorIndex = 4" & vbCrLf
    s = s & "                                nFix = nFix + 1" & vbCrLf
    s = s & "                            Else" & vbCrLf
    s = s & "                                r.HighlightColorIndex = 5" & vbCrLf
    s = s & "                                ImMark r, ""fix"", parts(4), parts(5)" & vbCrLf
    s = s & "                                nMark = nMark + 1" & vbCrLf
    s = s & "                            End If" & vbCrLf
    s = s & "                        Case ""flag""" & vbCrLf
    s = s & "                            r.HighlightColorIndex = 7" & vbCrLf
    s = s & "                            ImMark r, ""flag"", parts(4), parts(5)" & vbCrLf
    s = s & "                            nFlag = nFlag + 1" & vbCrLf
    s = s & "                    End Select" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    f.Close" & vbCrLf
    s = s & "    ' h/x xatolari ham shu tekshiruvda (H/X bazasi asosida)" & vbCrLf
    s = s & "    gHxFix = 0" & vbCrLf
    s = s & "    gHxAmb = 0" & vbCrLf
    s = s & "    gHxMark = 0" & vbCrLf
    s = s & "    If HxLoad() Then" & vbCrLf
    s = s & "        gHxMode = mode" & vbCrLf
    s = s & "        HxRange scope" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    nFix = nFix + gHxFix" & vbCrLf
    s = s & "    nMark = nMark + gHxMark" & vbCrLf
    s = s & "    nFlag = nFlag + gHxAmb" & vbCrLf
    s = s & "    EndUndo" & vbCrLf
    s = s & "    Application.ScreenUpdating = True" & vbCrLf
    s = s & "    If gImQuick Then Exit Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    msg = ""Imlo tekshiruvi tugadi."" & vbCrLf & vbCrLf" & vbCrLf
    s = s & "    If mode = 1 Then" & vbCrLf
    s = s & "        msg = msg & ""Tuzatildi (yashil): "" & nFix & ""  (shundan h/x: "" & gHxFix & "")"" & vbCrLf & _" & vbCrLf
    s = s & "                    ""O', g' va tutuq belgisi to'g'rilandi: "" & nApos & vbCrLf" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        msg = msg & ""Xato deb belgilandi (pushti): "" & nMark & vbCrLf" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    msg = msg & ""Tekshirish kerak (sariq): "" & nFlag & vbCrLf & vbCrLf & _" & vbCrLf
    s = s & "          ""Ctrl+Z bilan barcha o'zgarishlarni qaytarish mumkin.""" & vbCrLf
    s = s & "    If nMark + nFlag + gHxMark + gHxAmb > 0 Then" & vbCrLf
    s = s & "        msg = msg & vbCrLf & vbCrLf & ""Belgilangan joylar uchun takliflar menyusini hozir ochaymi?"" & vbCrLf & _" & vbCrLf
    s = s & "              ""(Taklifni sichqoncha bilan tanlasangiz, so'z o'zi almashadi.)""" & vbCrLf
    s = s & "        If MsgBox(msg, vbYesNo + vbInformation, ""Imlo tekshirish"") = vbYes Then" & vbCrLf
    s = s & "            Selection.SetRange scope.Start, scope.Start" & vbCrLf
    s = s & "            ImNext True" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        MsgBox msg, vbInformation, ""Imlo tekshirish""" & vbCrLf
    s = s & "    End If" & vbCrLf
    ModPart20 = s
End Function

Function ModPart21()
    Dim s
    s = ""
    s = s & "    Exit Sub" & vbCrLf
    s = s & "Fail:" & vbCrLf
    s = s & "    errNum = Err.Number" & vbCrLf
    s = s & "    errDesc = Err.Description" & vbCrLf
    s = s & "    EndUndo" & vbCrLf
    s = s & "    Application.ScreenUpdating = True" & vbCrLf
    s = s & "    Application.StatusBar = False" & vbCrLf
    s = s & "    MsgBox ""Xatolik "" & CStr(errNum) & "": "" & errDesc, vbExclamation, ""Imlo tekshirish""" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "'------------------------- Takliflar: bosib almashtirish ------------------" & vbCrLf
    s = s & "' Imlo va H/X tekshiruvi shubhali so'zlarni yashirin xatcho'p (_klN) bilan belgilaydi." & vbCrLf
    s = s & "' Takliflar hujjat o'zgaruvchisida (klN) saqlanadi: ""tur|qoida|taklif1 / taklif2""." & vbCrLf
    s = s & "' ImKeyingi / ImJoriy takliflar menyusini ochadi; tanlangan taklif so'zni o'zi almashtiradi." & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function ImMarkNum(ByVal nm As String) As Long" & vbCrLf
    s = s & "    Dim s As String" & vbCrLf
    s = s & "    ImMarkNum = 0" & vbCrLf
    s = s & "    If LCase$(Left$(nm, 3)) <> ""_kl"" Then Exit Function" & vbCrLf
    s = s & "    s = Mid$(nm, 4)" & vbCrLf
    s = s & "    If Len(s) = 0 Or Len(s) > 7 Then Exit Function" & vbCrLf
    s = s & "    If s Like ""*[!0-9]*"" Then Exit Function" & vbCrLf
    s = s & "    ImMarkNum = CLng(s)" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub ImMarkInit()" & vbCrLf
    s = s & "    Dim b As Bookmark, n As Long" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "    gMarkN = 0" & vbCrLf
    s = s & "    For Each b In ActiveDocument.Bookmarks" & vbCrLf
    s = s & "        n = ImMarkNum(b.Name)" & vbCrLf
    s = s & "        If n > gMarkN Then gMarkN = n" & vbCrLf
    s = s & "    Next b" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub ImClearMarks(ByVal scope As Range)" & vbCrLf
    s = s & "    Dim b As Bookmark, col As Collection, v As Variant, r As Range, ci As Long, nm As String" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "    Set col = New Collection" & vbCrLf
    s = s & "    For Each b In ActiveDocument.Bookmarks" & vbCrLf
    s = s & "        If ImMarkNum(b.Name) > 0 Then" & vbCrLf
    s = s & "            If b.Start >= scope.Start And b.End <= scope.End Then col.Add b.Name" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next b" & vbCrLf
    s = s & "    For Each v In col" & vbCrLf
    s = s & "        nm = CStr(v)" & vbCrLf
    s = s & "        Set r = ActiveDocument.Bookmarks(nm).Range" & vbCrLf
    s = s & "        ci = r.HighlightColorIndex" & vbCrLf
    s = s & "        If ci = 5 Or ci = 7 Then r.HighlightColorIndex = 0" & vbCrLf
    s = s & "        ActiveDocument.Bookmarks(nm).Delete" & vbCrLf
    s = s & "        ActiveDocument.Variables(""kl"" & Mid$(nm, 4)).Delete" & vbCrLf
    s = s & "    Next v" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Sub ImMark(ByVal r As Range, ByVal kind As String, ByVal rule As String, ByVal sug As String)" & vbCrLf
    s = s & "    Dim n As Long, v As String" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    If r.StoryType <> 1 Then" & vbCrLf
    s = s & "        ActiveDocument.Comments.Add r, ""Imlo ("" & rule & ""): "" & sug" & vbCrLf
    s = s & "        Err.Clear" & vbCrLf
    s = s & "        Exit Sub" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    gMarkN = gMarkN + 1" & vbCrLf
    s = s & "    n = gMarkN" & vbCrLf
    s = s & "    v = kind & ""|"" & rule & ""|"" & sug" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "    ActiveDocument.Bookmarks.Add ""_kl"" & n, r" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "    ActiveDocument.Variables.Add ""kl"" & n, v" & vbCrLf
    s = s & "    If Err.Number <> 0 Then" & vbCrLf
    s = s & "        Err.Clear" & vbCrLf
    s = s & "        ActiveDocument.Variables(""kl"" & n).Value = v" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    Err.Clear" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    ModPart21 = s
End Function

Function ModPart22()
    Dim s
    s = ""
    s = s & "Private Function ImMarkInfo(ByVal bm As String, ByRef kind As String, ByRef rule As String, ByRef sug As String) As Boolean" & vbCrLf
    s = s & "    Dim v As String, p() As String" & vbCrLf
    s = s & "    ImMarkInfo = False" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    v = ActiveDocument.Variables(""kl"" & Mid$(bm, 4)).Value" & vbCrLf
