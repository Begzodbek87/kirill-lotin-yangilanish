    s = s & "        MsgBox ""Imlo bazasi topilmadi. Kirill-Lotin-ornatish.vbs ni qayta ishga tushiring."", vbExclamation, ""Imlo tekshirish""" & vbCrLf
    s = s & "        Exit Sub" & vbCrLf
