Function ModPart30()
    Dim s
    s = ""
    s = s & "    Set wsh = CreateObject(""WScript.Shell"")" & vbCrLf
    s = s & "    rc = wsh.Run(""cscript.exe //nologo //E:JScript """""" & root & ""\oak_biblio.js"""" """""" & inF & """""" """""" & outF & """""""", 0, True)" & vbCrLf
    s = s & "    Application.StatusBar = False" & vbCrLf
    s = s & "    If rc <> 0 Or Not fso.FileExists(outF) Then" & vbCrLf
    s = s & "        t = """"" & vbCrLf
    s = s & "        If fso.FileExists(outF & "".err"") Then" & vbCrLf
    s = s & "            Set f = fso.OpenTextFile(outF & "".err"", 1, False, -1)" & vbCrLf
    s = s & "            If Not f.AtEndOfStream Then t = f.ReadAll" & vbCrLf
    s = s & "            f.Close" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "        MsgBox ""Tekshiruv dasturi ishlamadi (kod "" & rc & ""). "" & t, vbExclamation, ""Adabiyotlar ro'yxati""" & vbCrLf
    s = s & "        Exit Sub" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    Set items = New Collection" & vbCrLf
    s = s & "    Set f = fso.OpenTextFile(outF, 1, False, -1)" & vbCrLf
    s = s & "    Do While Not f.AtEndOfStream" & vbCrLf
    s = s & "        items.Add f.ReadLine" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    f.Close" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    rep = """"" & vbCrLf
    s = s & "    composed = """"" & vbCrLf
    s = s & "    Set hdrs = New Collection" & vbCrLf
    s = s & "    nLines = 0" & vbCrLf
    s = s & "    For Each v In items" & vbCrLf
    s = s & "        ln = CStr(v)" & vbCrLf
    s = s & "        parts = Split(ln, vbTab)" & vbCrLf
    s = s & "        If parts(0) = ""R"" Then" & vbCrLf
    s = s & "            If UBound(parts) >= 1 Then rep = rep & parts(1)" & vbCrLf
    s = s & "            rep = rep & vbCr" & vbCrLf
    s = s & "        ElseIf parts(0) = ""H"" Then" & vbCrLf
    s = s & "            nLines = nLines + 1" & vbCrLf
    s = s & "            hdrs.Add nLines" & vbCrLf
    s = s & "            composed = composed & parts(2) & vbCr" & vbCrLf
    s = s & "        ElseIf parts(0) = ""N"" Then" & vbCrLf
    s = s & "            nLines = nLines + 1" & vbCrLf
    s = s & "            composed = composed & parts(1) & "". "" & parts(4) & vbCr" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next v" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "    If mode <> ""check"" And nLines > 0 Then" & vbCrLf
    s = s & "        Application.ScreenUpdating = False" & vbCrLf
    s = s & "        BeginUndo" & vbCrLf
    s = s & "        orig.Bookmarks.ShowHidden = True" & vbCrLf
    s = s & "        On Error Resume Next" & vbCrLf
    s = s & "        orig.Bookmarks(""_klBib"").Delete" & vbCrLf
    s = s & "        On Error GoTo Fail" & vbCrLf
    s = s & "        orig.Bookmarks.Add ""_klBib"", orig.Range(lS, lE)" & vbCrLf
    s = s & "        ' 1. matndagi havolalarni yangilash (faylda oxiridan boshiga qarab)" & vbCrLf
    s = s & "        nEdit = 0" & vbCrLf
    s = s & "        For Each v In items" & vbCrLf
    s = s & "            parts = Split(CStr(v), vbTab)" & vbCrLf
    s = s & "            If parts(0) = ""C"" Then" & vbCrLf
    s = s & "                idx = CLng(parts(1))" & vbCrLf
    s = s & "                Set r = orig.Range(bS(idx) + CLng(parts(2)), bS(idx) + CLng(parts(3)))" & vbCrLf
    s = s & "                If r.Text = parts(5) Then" & vbCrLf
    s = s & "                    r.Text = parts(4)" & vbCrLf
    s = s & "                    nEdit = nEdit + 1" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        Next v" & vbCrLf
    s = s & "        ' 2. ro'yxatni qayta yozish" & vbCrLf
    s = s & "        Set r = orig.Bookmarks(""_klBib"").Range" & vbCrLf
    s = s & "        Set firstP = r.Paragraphs(1)" & vbCrLf
    s = s & "        Set fmt = firstP.Format.Duplicate" & vbCrLf
    s = s & "        fName = firstP.Range.Font.Name" & vbCrLf
    s = s & "        fSize = firstP.Range.Font.Size" & vbCrLf
    s = s & "        If Right$(composed, 1) = vbCr Then composed = Left$(composed, Len(composed) - 1)" & vbCrLf
    s = s & "        r.End = r.End - 1" & vbCrLf
    s = s & "        r.Text = composed" & vbCrLf
    s = s & "        r.ListFormat.RemoveNumbers" & vbCrLf
    s = s & "        r.ParagraphFormat = fmt" & vbCrLf
    s = s & "        r.Font.Bold = False" & vbCrLf
    s = s & "        If Len(fName) > 0 Then r.Font.Name = fName" & vbCrLf
    s = s & "        If fSize > 0 And fSize < 1000 Then r.Font.Size = fSize" & vbCrLf
    s = s & "        For Each v In hdrs" & vbCrLf
    s = s & "            Set pr = r.Paragraphs(CLng(v))" & vbCrLf
    s = s & "            pr.Alignment = 1" & vbCrLf
    s = s & "            pr.FirstLineIndent = 0" & vbCrLf
    ModPart30 = s
End Function

Function ModPart31()
    Dim s
    s = ""
    s = s & "            pr.LeftIndent = 0" & vbCrLf
