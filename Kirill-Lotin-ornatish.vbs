    s = s & "        HttpGet = r.ResponseText" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Function SaveBinary(path, data)" & vbCrLf
    s = s & "    Dim st" & vbCrLf
    s = s & "    SaveBinary = False" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    Set st = CreateObject(""ADODB.Stream"")" & vbCrLf
