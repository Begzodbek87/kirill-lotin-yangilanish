    s = s & "                    Else" & vbCrLf
    s = s & "                        parts = Split(rec, ""|"")" & vbCrLf
    s = s & "                        If UBound(parts) = 1 Then" & vbCrLf
    s = s & "                            wf = Split(ImSufForms(parts(0)), ""|"")" & vbCrLf
    s = s & "                            rf = Split(ImSufForms(parts(1)), ""|"")" & vbCrLf
    s = s & "                            If UBound(wf) = UBound(rf) Then" & vbCrLf
    s = s & "                                For i = 0 To UBound(wf)" & vbCrLf
    s = s & "                                    If Not skip.Exists(wf(i)) Then gIm(wf(i)) = rf(i)" & vbCrLf
    s = s & "                                Next i" & vbCrLf
    s = s & "                            End If" & vbCrLf
    s = s & "                        End If" & vbCrLf
    s = s & "                    End If" & vbCrLf
    s = s & "                End If" & vbCrLf
    s = s & "            Next j" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    f.Close" & vbCrLf
    s = s & "    Application.StatusBar = False" & vbCrLf
    s = s & "    ImLoadMap = True" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Public Sub ImPreload()" & vbCrLf
    s = s & "    On Error Resume Next" & vbCrLf
    s = s & "    If HxLoad() Then" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    If ImLoadMap() Then" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    Application.StatusBar = False" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "' so'zni ichki shaklga: kichik harf, o'/g' -> ', boshqa apostrof -> `" & vbCrLf
    s = s & "Private Function ImKeyOf(ByVal w As String) As String" & vbCrLf
    s = s & "    Dim i As Long, r As String, pc As String" & vbCrLf
    s = s & "    w = LCase$(w)" & vbCrLf
    s = s & "    For i = 1 To Len(w)" & vbCrLf
    s = s & "        If HxIsApos(CodeAt(w, i)) Then" & vbCrLf
    s = s & "            pc = Right$(r, 1)" & vbCrLf
    s = s & "            If pc = ""o"" Or pc = ""g"" Then r = r & ""'"" Else r = r & ""`""" & vbCrLf
    s = s & "        Else" & vbCrLf
    s = s & "            r = r & Mid$(w, i, 1)" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    ImKeyOf = r" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "' so'z ichidagi apostroflarni to'g'ri belgiga: o'/g' dan keyin -> OAp, boshqa harfdan keyin -> TAp" & vbCrLf
    s = s & "Private Function ImFixApos(ByVal w As String) As String" & vbCrLf
    s = s & "    Dim i As Long, r As String, pc As String, isLast As Boolean" & vbCrLf
    s = s & "    r = w" & vbCrLf
    s = s & "    For i = 2 To Len(w)" & vbCrLf
    s = s & "        If HxIsApos(CodeAt(w, i)) Then" & vbCrLf
    s = s & "            pc = LCase$(Mid$(w, i - 1, 1))" & vbCrLf
    s = s & "            isLast = (i = Len(w))" & vbCrLf
    s = s & "            If pc = ""o"" Or pc = ""g"" Then" & vbCrLf
    s = s & "                Mid$(r, i, 1) = OAp()" & vbCrLf
    s = s & "            ElseIf Not isLast And IsLetterCode(CodeAt(w, i - 1)) And IsLetterCode(CodeAt(w, i + 1)) Then" & vbCrLf
    s = s & "                Mid$(r, i, 1) = TAp()" & vbCrLf
    s = s & "            End If" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    ImFixApos = r" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function ImCase(ByVal orig As String, ByVal s As String) As String" & vbCrLf
    s = s & "    If Len(orig) > 1 And orig = UCase$(orig) And orig <> LCase$(orig) Then" & vbCrLf
    s = s & "        ImCase = UCase$(s)" & vbCrLf
    s = s & "    ElseIf Left$(orig, 1) <> LCase$(Left$(orig, 1)) Then" & vbCrLf
    s = s & "        ImCase = UCase$(Left$(s, 1)) & Mid$(s, 2)" & vbCrLf
    s = s & "    Else" & vbCrLf
    s = s & "        ImCase = s" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "End Function" & vbCrLf
    s = s & "" & vbCrLf
    s = s & "Private Function ImIsWordChar(ByVal c As Long) As Boolean" & vbCrLf
    s = s & "    ImIsWordChar = IsLetterCode(c) Or HxIsApos(c) Or c = 45" & vbCrLf
    s = s & "End Function" & vbCrLf
    ModPart32 = s
End Function

Function ModPart33()
    Dim s
    s = ""
    s = s & "" & vbCrLf
    s = s & "Private Sub ImTypedFix()" & vbCrLf
    s = s & "    Dim r As Range, wr As Range, t As String, s As Long, e As Long, w As String, cand As String" & vbCrLf
    s = s & "    Dim nt As String, note As String, k As String, ae As Object, nC As Long, i As Long, c As Long" & vbCrLf
    s = s & "    Dim pre As String, capIt As Boolean, ac As Object, rs As Long, tail As Long, np As Long" & vbCrLf
    s = s & "    Set r = Selection.Range.Duplicate" & vbCrLf
    s = s & "    r.MoveStart 1, -60" & vbCrLf
    s = s & "    t = r.Text" & vbCrLf
    s = s & "    e = Len(t)" & vbCrLf
    s = s & "    Do While e > 0" & vbCrLf
    s = s & "        If InStr("".,!?;:)"""""" & ChrW(&HBB) & ChrW(&H201D) & ChrW(&H2026), Mid$(t, e, 1)) > 0 Then e = e - 1 Else Exit Do" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    s = e" & vbCrLf
    s = s & "    Do While s > 0" & vbCrLf
    s = s & "        If ImIsWordChar(CodeAt(t, s)) Then s = s - 1 Else Exit Do" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    Do While s < e" & vbCrLf
    s = s & "        c = CodeAt(t, s + 1)" & vbCrLf
    s = s & "        If c = 45 Or HxIsApos(c) Then s = s + 1 Else Exit Do" & vbCrLf
    s = s & "    Loop" & vbCrLf
    s = s & "    If e - s < 2 Then Exit Sub" & vbCrLf
    s = s & "    w = Mid$(t, s + 1, e - s)" & vbCrLf
    s = s & "    cand = w" & vbCrLf
    s = s & "    For i = 1 To Len(w)" & vbCrLf
    s = s & "        c = CodeAt(w, i)" & vbCrLf
    s = s & "        If c >= &H400 And c <= &H4FF Then nC = nC + 1" & vbCrLf
    s = s & "    Next i" & vbCrLf
    s = s & "    ' 1) h/x" & vbCrLf
    s = s & "    If HxLoad() Then" & vbCrLf
    s = s & "        nt = """"" & vbCrLf
    s = s & "        If HxCheck(cand, nt, note) = 1 Then cand = nt" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    ' 2) imlo (lotin yozuvi)" & vbCrLf
    s = s & "    If nC = 0 Then" & vbCrLf
    s = s & "        If ImLoadMap() Then" & vbCrLf
    s = s & "            k = ImKeyOf(cand)" & vbCrLf
    s = s & "            If gIm.Exists(k) Then cand = ImCase(cand, ImDisp(gIm(k)))" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    ' 2b) o', g' va tutuq belgisini to'g'rilash" & vbCrLf
    s = s & "    If nC = 0 Then cand = ImFixApos(cand)" & vbCrLf
    s = s & "    ' 3) Word'ning o'z avtozamena yozuvlari" & vbCrLf
    s = s & "    If cand = w Then" & vbCrLf
    s = s & "        On Error Resume Next" & vbCrLf
    s = s & "        Set ae = Nothing" & vbCrLf
    s = s & "        Set ac = Application.AutoCorrect" & vbCrLf
    s = s & "        Set ae = ac.Entries(w)" & vbCrLf
    s = s & "        If ae Is Nothing Then Set ae = ac.Entries(LCase$(w))" & vbCrLf
    s = s & "        If Not ae Is Nothing Then" & vbCrLf
    s = s & "            If ae.RichText = False Then cand = ImCase(w, ae.Value)" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "        Err.Clear" & vbCrLf
    s = s & "        On Error GoTo 0" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    ' 4) gap boshidagi bosh harf" & vbCrLf
    s = s & "    If Application.AutoCorrect.CorrectSentenceCaps Then" & vbCrLf
    s = s & "        pre = RTrim$(Replace(Left$(t, s), Chr$(160), "" ""))" & vbCrLf
    s = s & "        capIt = False" & vbCrLf
    s = s & "        If Len(pre) = 0 Then" & vbCrLf
    s = s & "            capIt = (r.Start = 0)" & vbCrLf
    s = s & "        ElseIf Right$(pre, 1) = vbCr Or Right$(pre, 1) = Chr$(7) Or Right$(pre, 1) = Chr$(11) Then" & vbCrLf
    s = s & "            capIt = True" & vbCrLf
    s = s & "        ElseIf InStr("".!?"", Right$(pre, 1)) > 0 And Len(pre) >= 4 Then" & vbCrLf
    s = s & "            capIt = IsLetterCode(CodeAt(pre, Len(pre) - 1)) And IsLetterCode(CodeAt(pre, Len(pre) - 2)) And IsLetterCode(CodeAt(pre, Len(pre) - 3))" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "        If capIt Then cand = UCase$(Left$(cand, 1)) & Mid$(cand, 2)" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "    If cand <> w Then" & vbCrLf
    s = s & "        rs = r.Start" & vbCrLf
    s = s & "        tail = Len(t) - e" & vbCrLf
    s = s & "        Set wr = r.Duplicate" & vbCrLf
    s = s & "        wr.SetRange rs + s, rs + e" & vbCrLf
    s = s & "        If wr.Text = w Then" & vbCrLf
    s = s & "            wr.Text = cand" & vbCrLf
    s = s & "            np = rs + s + Len(cand) + tail" & vbCrLf
    s = s & "            Selection.SetRange np, np" & vbCrLf
    s = s & "        End If" & vbCrLf
    s = s & "    End If" & vbCrLf
    s = s & "End Sub" & vbCrLf
    s = s & "" & vbCrLf
    ModPart33 = s
End Function

