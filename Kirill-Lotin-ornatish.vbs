    s = s & "    Application.StatusBar = ""Imlo tekshirilmoqda...""" & vbCrLf
    s = s & "    Set wsh = CreateObject(""WScript.Shell"")" & vbCrLf
    s = s & "    rc = wsh.Run(""cscript.exe //nologo //E:JScript """""" & js & """""" """""" & dataF & """""" """""" & inF & """""" """""" & outF & """""""", 0, True)" & vbCrLf
    s = s & "    Application.StatusBar = False" & vbCrLf
    s = s & "    If rc <> 0 Or Not fso.FileExists(outF) Then" & vbCrLf
    s = s & "        msg = """"" & vbCrLf
