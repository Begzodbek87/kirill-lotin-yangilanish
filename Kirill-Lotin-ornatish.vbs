    s = s & "Mutaxassislarning ta" & ChrW(700) & "kidlashicha, o" & ChrW(699) & "zbek tilida ishlaydigan dasturlarga talab tobora ortib bormoqda. Ayniqsa, matnlarni avtomatik tahlil qiladigan, imlo xatolarini tuzatadigan va nutqni taniydigan dasturlar zarur. Bunday dasturlarni yaratish uchun katta hajmdagi til korpuslari kerak bo" & ChrW(699) & "ladi." & vbCrLf
