    s = s & "    If Dir$(vbsP) = """" Then" & vbCrLf
    s = s & "        MsgBox ""Yangilash vositasi topilmadi. Kirill-Lotin-ornatish.vbs ni qayta ishga tushiring."", vbExclamation, ""Yangilash""" & vbCrLf
    s = s & "        Exit Sub" & vbCrLf
